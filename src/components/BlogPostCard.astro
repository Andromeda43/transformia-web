---
// src/components/BlogPostCard.astro — fila de artículo (lista editorial, no tarjeta).
import type { CollectionEntry } from 'astro:content';
import Icon from './ui/Icon.astro';

interface Props {
  entry: CollectionEntry<'blog'>;
  headingLevel?: 'h2' | 'h3';
}
const { entry, headingLevel: H = 'h3' } = Astro.props;
const { title, description, pubDate, tags } = entry.data;
const fecha = pubDate.toLocaleDateString('es-CO', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<article class="post-row" data-reveal>
  <a href={`/blog/${entry.id}`} class="post-row-link">
    <time class="post-date mono" datetime={pubDate.toISOString()}>{fecha}</time>
    <div class="post-main">
      <H class="post-title">{title}</H>
      <p class="post-desc">{description}</p>
      {tags.length > 0 && (
        <ul class="post-tags" role="list">
          {tags.map((t) => <li class="mono">{t}</li>)}
        </ul>
      )}
    </div>
    <span class="post-arrow"><Icon name="arrow-up-right" size={22} /></span>
  </a>
</article>

<style>
  .post-row {
    border-top: 1px solid var(--border);
  }
  .post-row:last-child {
    border-bottom: 1px solid var(--border);
  }
  .post-row-link {
    display: grid;
    grid-template-columns: 9rem 1fr auto;
    gap: 2rem;
    padding: 2rem 0.5rem;
    transition: background var(--dur) var(--ease-out);
  }
  .post-row-link:hover {
    background: linear-gradient(90deg, transparent, rgba(var(--accent-rgb), 0.06), transparent);
  }
  .post-date {
    padding-top: 0.35rem;
    font-size: 0.8rem;
    color: var(--text-subtle);
  }
  .post-main {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .post-title {
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.6rem);
    letter-spacing: -0.02em;
    transition: color var(--dur-fast);
  }
  .post-row-link:hover .post-title {
    color: var(--accent-text);
  }
  .post-desc {
    color: var(--text-muted);
    font-size: var(--text-small);
    max-width: 68ch;
  }
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .post-tags li {
    font-size: 0.7rem;
    color: var(--text-subtle);
  }
  .post-tags li + li::before {
    content: '·';
    margin-right: 0.5rem;
  }
  .post-arrow {
    align-self: center;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    color: var(--text-muted);
    transition: background var(--dur), color var(--dur), border-color var(--dur), transform var(--dur) var(--ease-out);
  }
  .post-row-link:hover .post-arrow {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
    transform: rotate(45deg);
  }
  @media (max-width: 720px) {
    .post-row-link {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      padding: 1.5rem 0;
    }
    .post-arrow {
      display: none;
    }
  }
</style>
