---
// src/components/BlogPostCard.astro
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { title, description, pubDate, tags } = entry.data;

const formattedDate = pubDate.toLocaleDateString('es-CO', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<a href={`/blog/${entry.id}`} class="post-card">
  <div class="post-card-accent"></div>
  <div class="post-card-body">
    <div class="post-card-meta">
      <svg class="post-card-meta-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
        <line x1="16" y1="2" x2="16" y2="6"></line>
        <line x1="8" y1="2" x2="8" y2="6"></line>
        <line x1="3" y1="10" x2="21" y2="10"></line>
      </svg>
      <span class="post-card-date">{formattedDate}</span>
    </div>
    <h3 class="post-card-title">{title}</h3>
    <p class="post-card-description">{description}</p>
    <div class="post-card-tags">
      {tags.map((tag) => (
        <span class="post-card-tag">
          <span class="post-card-tag-dot"></span>
          {tag}
        </span>
      ))}
    </div>
    <span class="post-card-link">Leer artículo →</span>
  </div>
</a>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    background: rgba(26, 20, 45, 0.6);
    border: 1px solid rgba(var(--neon-purple-rgb), 0.25);
    border-radius: var(--radius-card);
    text-decoration: none;
    color: white;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    overflow: hidden;
  }

  .post-card:hover {
    border-color: var(--neon-blue);
    box-shadow: 0 10px 30px rgba(var(--neon-blue-rgb), 0.18);
    transform: translateY(-4px);
  }

  .post-card-accent {
    height: 4px;
    background: linear-gradient(90deg, var(--neon-blue), var(--neon-purple));
  }

  .post-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.75rem;
    flex: 1;
  }

  .post-card-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .post-card-meta-icon {
    width: 14px;
    height: 14px;
    color: var(--neon-blue);
  }

  .post-card-date {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--neon-blue);
  }

  .post-card-title {
    font-family: var(--font-body);
    font-size: 1.2rem;
  }

  .post-card-description {
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.6;
    font-size: 0.95rem;
  }

  .post-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .post-card-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 20px;
    padding: 0.2rem 0.65rem 0.2rem 0.5rem;
  }

  .post-card-tag-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--neon-purple);
    flex-shrink: 0;
  }

  .post-card-link {
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--neon-blue);
  }
</style>
