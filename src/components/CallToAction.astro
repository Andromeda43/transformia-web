---
// src/components/CallToAction.astro — CTA final reutilizable. El brillo del fondo sigue al cursor.
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';
import { contacto, empresa, whatsappLink } from '../data/site';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Cuéntanos qué proceso te está frenando.',
  text = 'En una llamada de 30 minutos entendemos tu caso y te decimos, sin rodeos, si podemos ayudarte y cómo. Sin costo y sin compromiso.',
} = Astro.props;
---

<section class="cta-wrap" aria-labelledby="cta-title">
  <div class="container">
    <div class="cta spot" data-spotlight>
      <div class="blueprint"></div>
      <div class="cta-inner">
        <p class="eyebrow" data-reveal>{empresa.eslogan}</p>
        <h2 id="cta-title" class="h1 cta-title" data-split>{title}</h2>
        <p class="lead cta-text" data-reveal>{text}</p>
        <div class="cta-actions" data-reveal>
          <Button href="/contacto" icon="arrow" magnetic>Agenda un diagnóstico</Button>
          <Button href={whatsappLink()} variant="secondary" iconStart="whatsapp" external>WhatsApp</Button>
        </div>
        <div class="cta-channels mono" data-reveal>
          <a href={`tel:${contacto.telefonoE164}`}><Icon name="phone" size={15} /> {contacto.telefono}</a>
          <a href={`mailto:${contacto.email}`}><Icon name="mail" size={15} /> {contacto.email}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-wrap {
    padding-block: var(--section-y);
  }
  .cta {
    position: relative;
    overflow: hidden;
    padding: clamp(3rem, 2rem + 5vw, 6.5rem) clamp(1.5rem, 1rem + 4vw, 5rem);
    border-radius: calc(var(--radius-lg) + 6px);
    background:
      radial-gradient(90% 120% at 50% 120%, rgba(var(--accent-rgb), 0.3), transparent 60%),
      var(--surface-1);
  }
  .cta-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    max-width: 820px;
    margin-inline: auto;
    text-align: center;
  }
  .cta-text {
    margin-inline: auto;
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  .cta-channels {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.75rem;
    margin-top: 0.75rem;
    font-size: 0.82rem;
    color: var(--text-muted);
  }
  .cta-channels a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    transition: color var(--dur-fast);
  }
  .cta-channels a:hover {
    color: var(--text);
  }
  @media (max-width: 520px) {
    .cta-actions :global(.btn) {
      width: 100%;
    }
  }
</style>
