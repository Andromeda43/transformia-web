---
// src/components/CaseStudyCard.astro
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  slug: string;
  cliente: string;
  industria: string;
  resultadoCorto: string;
  status: 'ejecutado' | 'propuesta';
  image?: ImageMetadata;
}

const { slug, cliente, industria, resultadoCorto, status, image } = Astro.props;
---

<a href={`/casos-de-exito/${slug}`} class="case-card" class:list={{ 'case-card--with-image': !!image }}>
  {image ? (
    <div class="case-card-media">
      <Image src={image} alt={`Captura del sistema construido para ${cliente}`} widths={[320, 640]} sizes="(max-width: 768px) 100vw, 360px" loading="lazy" />
      <div class="case-card-media-fade"></div>
      {status === 'propuesta' && <span class="case-card-badge case-card-badge--media">Propuesta técnica</span>}
    </div>
  ) : (
    <div class="case-card-accent"></div>
  )}
  <div class="case-card-body">
    {!image && status === 'propuesta' && <span class="case-card-badge">Propuesta técnica</span>}
    <h3 class="case-card-title">{cliente}</h3>
    <p class="case-card-industry">{industria}</p>
    <p class="case-card-result">{resultadoCorto.slice(0, 140)}...</p>
    <span class="case-card-link">Ver caso completo →</span>
  </div>
</a>

<style>
  .case-card {
    display: flex;
    flex-direction: column;
    background: rgba(26, 20, 45, 0.6);
    border: 1px solid rgba(var(--neon-purple-rgb), 0.25);
    border-radius: var(--radius-card);
    text-decoration: none;
    color: white;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    overflow: hidden;
  }

  .case-card:hover {
    border-color: var(--neon-purple);
    box-shadow: 0 10px 30px rgba(var(--neon-purple-rgb), 0.18);
    transform: translateY(-4px);
  }

  .case-card-accent {
    height: 4px;
    background: linear-gradient(90deg, var(--neon-purple), var(--neon-blue));
  }

  .case-card-media {
    position: relative;
    line-height: 0;
  }

  .case-card-media :global(img) {
    display: block;
    width: 100%;
    height: 170px;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .case-card:hover .case-card-media :global(img) {
    transform: scale(1.06);
  }

  .case-card-media-fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 40%, rgba(26, 20, 45, 0.95) 100%);
    pointer-events: none;
  }

  .case-card-badge {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--neon-yellow);
    border: 1px solid var(--neon-yellow);
    border-radius: 4px;
    padding: 0.2rem 0.5rem;
    margin-bottom: 0.5rem;
  }

  .case-card-badge--media {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    margin-bottom: 0;
    background: rgba(10, 10, 20, 0.75);
    backdrop-filter: blur(4px);
  }

  .case-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem;
    flex: 1;
  }

  .case-card--with-image .case-card-body {
    padding-top: 1.25rem;
  }

  .case-card-title {
    font-family: var(--font-body);
    font-size: 1.3rem;
    color: white;
  }

  .case-card-industry {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--neon-purple);
  }

  .case-card-result {
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.6;
    font-size: 0.95rem;
  }

  .case-card-link {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--neon-blue);
  }
</style>
