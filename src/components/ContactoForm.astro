---
// src/components/ContactoForm.astro
// Formulario sin backend: arma el mensaje y lo abre en WhatsApp o en el correo, listo para enviar.
import Icon from './ui/Icon.astro';
import { contacto, whatsappLink } from '../data/site';
import { servicios } from '../data/servicios';

const pasos = [
  { t: 'Nos cuentas el proceso', d: 'Qué te está frenando, cómo se hace hoy y qué te gustaría lograr.' },
  { t: 'Diagnóstico de 30 minutos', d: 'Una llamada para entender tu caso. Sin costo y sin compromiso.' },
  { t: 'Propuesta por fases', d: 'Alcance, inversión fija por fase, tiempos y lo que no incluye.' },
];
---

<section class="contact">
  <div class="blueprint"></div>
  <div class="container contact-grid">
    <div class="contact-info">
      <p class="eyebrow" data-reveal>Contacto</p>
      <h1 class="h1" data-split>Hablemos de tu proyecto.</h1>
      <p class="lead" data-reveal>Cuéntanos qué necesitas. Te respondemos personalmente, sin bots ni formularios eternos.</p>

      <div class="channels" data-reveal>
        <a href={whatsappLink()} class="channel channel--primary" target="_blank" rel="noopener noreferrer">
          <span class="channel-icon"><Icon name="whatsapp" size={20} /></span>
          <span><b>WhatsApp</b><span class="mono">{contacto.telefono}</span></span>
          <Icon name="arrow-up-right" size={18} class="channel-arrow" />
        </a>
        <a href={`mailto:${contacto.email}`} class="channel">
          <span class="channel-icon"><Icon name="mail" size={20} /></span>
          <span><b>Correo</b><span class="mono">{contacto.email}</span></span>
          <Icon name="arrow-up-right" size={18} class="channel-arrow" />
        </a>
        <a href={`tel:${contacto.telefonoE164}`} class="channel">
          <span class="channel-icon"><Icon name="phone" size={20} /></span>
          <span><b>Llamada</b><span class="mono">{contacto.telefono}</span></span>
          <Icon name="arrow-up-right" size={18} class="channel-arrow" />
        </a>
      </div>

      <ol class="steps" role="list" data-reveal>
        {pasos.map((p, i) => (
          <li>
            <span class="mono step-num">{String(i + 1).padStart(2, '0')}</span>
            <div><b>{p.t}</b><p>{p.d}</p></div>
          </li>
        ))}
      </ol>
    </div>

    <form
      class="form spot"
      data-contact-form
      action={`mailto:${contacto.email}`}
      method="post"
      enctype="text/plain"
      novalidate
      data-reveal
    >
      <div class="form-head">
        <p class="h3">Cuéntanos tu caso</p>
        <p class="muted form-sub">Al enviar se abre WhatsApp o tu correo con el mensaje listo. Tú decides cuándo enviarlo.</p>
      </div>

      <div class="row">
        <label class="field">
          <span>Nombre *</span>
          <input name="nombre" type="text" autocomplete="name" required />
        </label>
        <label class="field">
          <span>Empresa</span>
          <input name="empresa" type="text" autocomplete="organization" />
        </label>
      </div>
      <div class="row">
        <label class="field">
          <span>Correo *</span>
          <input name="correo" type="email" autocomplete="email" required />
        </label>
        <label class="field">
          <span>Teléfono</span>
          <input name="telefono" type="tel" autocomplete="tel" />
        </label>
      </div>
      <label class="field">
        <span>¿Qué necesitas?</span>
        <select name="servicio">
          <option value="">Selecciona una opción</option>
          {servicios.map((s) => <option value={s.nombre}>{s.nombre}</option>)}
          <option value="Otro / no estoy seguro">Otro / no estoy seguro</option>
        </select>
      </label>
      <label class="field">
        <span>Cuéntanos el proceso *</span>
        <textarea name="mensaje" rows="5" required placeholder="Ej.: llevamos los pedidos en Excel y perdemos el rastro de qué se despachó…"></textarea>
      </label>

      <label class="consent">
        <input type="checkbox" name="autorizacion" required />
        <span>Autorizo el tratamiento de mis datos según la <a href="/privacidad">política de datos</a> (Ley 1581 de 2012).</span>
      </label>

      <p class="form-error" data-form-error role="alert" hidden></p>

      <div class="form-actions">
        <button type="submit" class="btn btn--primary" data-channel="whatsapp" data-magnetic="0.15">
          <Icon name="whatsapp" /> Enviar por WhatsApp
        </button>
        <button type="submit" class="btn btn--secondary" data-channel="correo">
          <Icon name="mail" /> Enviar por correo
        </button>
      </div>
    </form>
  </div>
</section>

<style>
  .contact {
    position: relative;
    padding: calc(var(--nav-height) + clamp(3rem, 2rem + 4vw, 5.5rem)) 0 var(--section-y);
    overflow: hidden;
  }
  .contact-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(2.5rem, 1.5rem + 4vw, 5rem);
    align-items: start;
  }
  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .channels {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: 0.75rem;
  }
  .channel {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-1);
    transition: border-color var(--dur-fast), background var(--dur-fast);
  }
  .channel:hover {
    border-color: var(--border-strong);
    background: var(--surface-2);
  }
  .channel--primary {
    border-color: rgba(var(--signal-rgb), 0.4);
  }
  .channel--primary .channel-icon {
    background: rgba(var(--signal-rgb), 0.12);
    color: var(--signal);
  }
  .channel > span:nth-child(2) {
    display: flex;
    flex-direction: column;
  }
  .channel b {
    font-weight: 500;
  }
  .channel .mono {
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .channel-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: var(--accent-soft);
    color: var(--accent-text);
  }
  .channel :global(.channel-arrow) {
    margin-left: auto;
    color: var(--text-subtle);
  }
  .steps {
    display: flex;
    flex-direction: column;
    margin-top: 1rem;
  }
  .steps li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.75rem;
    padding: 1rem 0;
    border-top: 1px solid var(--border);
  }
  .step-num {
    padding-top: 0.15rem;
    font-size: 0.75rem;
    color: var(--accent-text);
  }
  .steps b {
    font-weight: 500;
  }
  .steps p {
    color: var(--text-muted);
    font-size: var(--text-small);
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }
  .form-head {
    margin-bottom: 0.5rem;
  }
  .form-sub {
    margin-top: 0.35rem;
    font-size: 0.88rem;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .field > span {
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 0.8rem 0.95rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--bg);
    font-size: 1rem;
    transition: border-color var(--dur-fast), box-shadow var(--dur-fast);
  }
  .field textarea {
    resize: vertical;
    min-height: 130px;
  }
  .field ::placeholder {
    color: var(--text-subtle);
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(var(--accent-rgb), 0.2);
  }
  .field [aria-invalid='true'] {
    border-color: var(--danger);
  }
  .consent {
    display: flex;
    gap: 0.7rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .consent input {
    flex: none;
    width: 18px;
    height: 18px;
    margin-top: 0.15rem;
    accent-color: var(--accent);
  }
  .consent a {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .form-error {
    padding: 0.7rem 0.9rem;
    border: 1px solid rgba(255, 92, 122, 0.4);
    border-radius: var(--radius-sm);
    background: rgba(255, 92, 122, 0.08);
    color: var(--danger);
    font-size: 0.88rem;
  }
  .form-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  @media (max-width: 960px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .row {
      grid-template-columns: 1fr;
    }
    .form-actions .btn {
      width: 100%;
    }
  }
</style>

<script>
  import { contacto } from '../data/site';

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const error = form?.querySelector<HTMLElement>('[data-form-error]');

  if (form && error) {
    let channel = 'whatsapp';
    form.querySelectorAll<HTMLButtonElement>('[data-channel]').forEach((b) =>
      b.addEventListener('click', () => (channel = b.dataset.channel ?? 'whatsapp'))
    );

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const get = (k: string) => String(data.get(k) ?? '').trim();

      const missing: string[] = [];
      form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]').forEach((el) => {
        const ok = el.type === 'checkbox' ? (el as HTMLInputElement).checked : el.value.trim() !== '' && el.checkValidity();
        el.setAttribute('aria-invalid', String(!ok));
        if (!ok) missing.push(el.name);
      });
      if (missing.length) {
        error.hidden = false;
        error.textContent = missing.includes('autorizacion') && missing.length === 1
          ? 'Para continuar, autoriza el tratamiento de tus datos.'
          : 'Revisa los campos obligatorios: nombre, un correo válido, tu mensaje y la autorización de datos.';
        form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
        return;
      }
      error.hidden = true;

      const lineas = [
        `Hola, soy ${get('nombre')}${get('empresa') ? ` de ${get('empresa')}` : ''}.`,
        get('servicio') ? `Me interesa: ${get('servicio')}.` : '',
        '',
        get('mensaje'),
        '',
        `Correo: ${get('correo')}`,
        get('telefono') ? `Teléfono: ${get('telefono')}` : '',
      ].filter((l, i, arr) => l !== '' || (arr[i - 1] ?? '') !== '');
      const texto = lineas.join('\n').trim();

      if (channel === 'correo') {
        const asunto = `Proyecto de software — ${get('empresa') || get('nombre')}`;
        window.location.href = `mailto:${contacto.email}?subject=${encodeURIComponent(asunto)}&body=${encodeURIComponent(texto)}`;
      } else {
        window.open(`${contacto.whatsappBase}?text=${encodeURIComponent(texto)}`, '_blank', 'noopener');
      }
    });
  }
</script>
