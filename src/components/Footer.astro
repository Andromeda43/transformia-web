---
// src/components/Footer.astro
import Logo from './ui/Logo.astro';
import Icon from './ui/Icon.astro';
import { contacto, empresa, whatsappLink } from '../data/site';
import { servicios } from '../data/servicios';
import { casosDeExito } from '../data/casosDeExito';
import { productos } from '../data/productos';

const year = new Date().getFullYear();
const casosCliente = casosDeExito.filter((c) => c.relacion !== 'producto');
---

<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <Logo size={34} />
        <p class="footer-slogan">{empresa.eslogan}</p>
        <p class="footer-desc">
          Software a la medida, inteligencia artificial y automatización para empresas en Colombia y LatAm.
        </p>
        <div class="footer-contact">
          <a href={whatsappLink()} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" size={18} /> {contacto.telefono}</a>
          <a href={`mailto:${contacto.email}`}><Icon name="mail" size={18} /> {contacto.email}</a>
        </div>
      </div>

      <nav class="footer-cols" aria-label="Pie de página">
        <div class="footer-col">
          <p class="footer-title">Servicios</p>
          <ul role="list">
            {servicios.map((s) => <li><a href={`/servicios/${s.slug}`}>{s.nombreCorto}</a></li>)}
          </ul>
        </div>
        <div class="footer-col">
          <p class="footer-title">Casos</p>
          <ul role="list">
            {casosCliente.map((c) => <li><a href={`/casos-de-exito/${c.slug}`}>{c.nombreCorto ?? c.cliente}</a></li>)}
          </ul>
        </div>
        <div class="footer-col">
          <p class="footer-title">Productos</p>
          <ul role="list">
            {productos.map((p) => (
              <li>
                <a href={p.url} target="_blank" rel="noopener noreferrer">
                  {p.nombre} <Icon name="arrow-up-right" size={14} />
                </a>
              </li>
            ))}
          </ul>
          <p class="footer-title footer-title--spaced">Empresa</p>
          <ul role="list">
            <li><a href="/nosotros">Nosotros</a></li>
            <li><a href="/blog">Blog</a></li>
            <li><a href="/contacto">Contacto</a></li>
          </ul>
        </div>
      </nav>
    </div>

    <div class="footer-wordmark" aria-hidden="true">Transformia</div>

    <div class="footer-bottom">
      <p>© {year} {empresa.razonSocial} · NIT {empresa.nit} · {empresa.ubicacion.ciudad}, {empresa.ubicacion.region}, Colombia</p>
      <div class="footer-legal">
        <a href="/privacidad">Privacidad</a>
        <a href="/terminos">Términos</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding-top: clamp(4rem, 3rem + 4vw, 6rem);
    border-top: 1px solid var(--border);
    background: var(--bg-elevated);
    overflow: hidden;
  }
  .footer-top {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.6fr);
    gap: 3rem;
  }
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 360px;
  }
  .footer-slogan {
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    margin-top: 0.5rem;
  }
  .footer-desc {
    color: var(--text-muted);
    font-size: var(--text-small);
  }
  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }
  .footer-contact a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
    transition: color var(--dur-fast);
  }
  .footer-contact a:hover {
    color: var(--text);
  }
  .footer-cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }
  .footer-title {
    margin-bottom: 1rem;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }
  .footer-title--spaced {
    margin-top: 2rem;
  }
  .footer-col ul {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .footer-col a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--text-muted);
    font-size: var(--text-small);
    transition: color var(--dur-fast);
  }
  .footer-col a:hover {
    color: var(--text);
  }
  .footer-wordmark {
    margin-top: clamp(3rem, 2rem + 4vw, 5rem);
    font-size: clamp(4rem, 1rem + 15vw, 15rem);
    font-weight: 600;
    line-height: 0.8;
    letter-spacing: -0.06em;
    text-align: center;
    color: transparent;
    background: linear-gradient(180deg, var(--surface-3) 0%, transparent 95%);
    -webkit-background-clip: text;
    background-clip: text;
    user-select: none;
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem 0 2rem;
    border-top: 1px solid var(--border);
    font-size: 0.82rem;
    color: var(--text-subtle);
  }
  .footer-legal {
    display: flex;
    gap: 1.5rem;
  }
  .footer-legal a:hover {
    color: var(--text);
  }

  @media (max-width: 880px) {
    .footer-top {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .footer-cols {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
