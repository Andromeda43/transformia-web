---
// src/components/Navbar.astro — barra flotante: se oculta al bajar y reaparece al subir.
import Logo from './ui/Logo.astro';
import Icon from './ui/Icon.astro';
import { navegacion, contacto, whatsappLink } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="nav" data-nav>
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label="Transformia, ir al inicio">
      <Logo />
    </a>

    <nav class="nav-links" aria-label="Principal">
      {navegacion.map((item) => (
        <a href={item.href} class:list={['nav-link', { 'is-active': isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="nav-actions">
      <a href="/contacto" class="btn btn--primary nav-cta">Agenda un diagnóstico</a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-menu" aria-label="Abrir menú" data-nav-toggle>
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="nav-menu" id="nav-menu" data-nav-menu hidden>
    <nav class="nav-menu-links" aria-label="Menú móvil">
      {[{ href: '/', label: 'Inicio' }, ...navegacion, { href: '/contacto', label: 'Contacto' }].map((item, i) => (
        <a href={item.href} class="nav-menu-link" style={`--i:${i}`}>
          <span class="mono">{String(i + 1).padStart(2, '0')}</span>
          {item.label}
        </a>
      ))}
    </nav>
    <div class="nav-menu-foot">
      <a href={whatsappLink()} class="btn btn--primary" target="_blank" rel="noopener noreferrer">
        <Icon name="whatsapp" /> Escríbenos por WhatsApp
      </a>
      <a href={`mailto:${contacto.email}`} class="nav-menu-mail mono">{contacto.email}</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    padding: 14px var(--gutter) 0;
    transition: transform 0.45s var(--ease-out);
    pointer-events: none;
  }
  .nav.is-hidden {
    transform: translateY(-120%);
  }
  .nav-inner {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    max-width: var(--container-max);
    height: 58px;
    margin-inline: auto;
    padding: 0 0.5rem 0 1rem;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    transition: background var(--dur) var(--ease-out), border-color var(--dur) var(--ease-out),
      backdrop-filter var(--dur) var(--ease-out);
  }
  .nav.is-scrolled .nav-inner,
  .nav.is-open .nav-inner {
    background: rgba(15, 15, 24, 0.72);
    border-color: var(--border);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
  }

  .nav-links {
    display: flex;
    gap: 0.25rem;
  }
  .nav-link {
    position: relative;
    padding: 0.5rem 0.9rem;
    border-radius: var(--radius-pill);
    font-size: 0.95rem;
    color: var(--text-muted);
    transition: color var(--dur-fast), background var(--dur-fast);
  }
  .nav-link:hover {
    color: var(--text);
    background: rgba(255, 255, 255, 0.05);
  }
  .nav-link.is-active {
    color: var(--text);
  }
  .nav-link.is-active::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 2px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
    transform: translateX(-50%);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .nav-cta {
    min-height: 42px;
    padding: 0.5rem 1.1rem;
    font-size: 0.92rem;
  }

  .nav-toggle {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
  }
  .nav-toggle span {
    position: absolute;
    left: 13px;
    width: 18px;
    height: 1.5px;
    background: var(--text);
    transition: transform var(--dur) var(--ease-out), top var(--dur) var(--ease-out);
  }
  .nav-toggle span:first-child { top: 18px; }
  .nav-toggle span:last-child { top: 25px; }
  .nav.is-open .nav-toggle span:first-child { top: 21px; transform: rotate(45deg); }
  .nav.is-open .nav-toggle span:last-child { top: 21px; transform: rotate(-45deg); }

  .nav-menu {
    pointer-events: auto;
    position: fixed;
    inset: 0;
    z-index: -1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: calc(var(--nav-height) + 3rem) var(--gutter) 2.5rem;
    background: var(--bg);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity var(--dur) var(--ease-out), visibility 0s linear var(--dur);
  }
  /* `display: flex` anula el atributo hidden: sin esto el menú cerrado tapa la página y se roba los clics. */
  .nav-menu[hidden] {
    display: none;
  }
  .nav.is-open .nav-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity var(--dur) var(--ease-out), visibility 0s;
  }
  .nav-menu-links {
    display: flex;
    flex-direction: column;
  }
  .nav-menu-link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--border);
    font-size: clamp(1.8rem, 7vw, 2.4rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.5s var(--ease-out), transform 0.5s var(--ease-out);
    transition-delay: calc(var(--i) * 45ms + 80ms);
  }
  .nav-menu-link .mono {
    font-size: 0.75rem;
    color: var(--accent-text);
  }
  .nav.is-open .nav-menu-link {
    opacity: 1;
    transform: none;
  }
  .nav-menu-foot {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .nav-menu-mail {
    font-size: 0.85rem;
    color: var(--text-muted);
    text-align: center;
  }

  @media (max-width: 960px) {
    .nav-links { display: none; }
    .nav-toggle { display: block; }
  }
  @media (min-width: 961px) {
    .nav-menu { display: none; }
  }
  @media (max-width: 520px) {
    .nav-cta { display: none; }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-nav-menu]');

  if (nav && toggle && menu) {
    let lastY = window.scrollY;
    let ticking = false;

    const update = () => {
      const y = window.scrollY;
      const delta = y - lastY;
      nav.classList.toggle('is-scrolled', y > 24);
      // Solo cambia con un desplazamiento claro (ignora el rebote del trackpad y micro-movimientos).
      if (!nav.classList.contains('is-open') && Math.abs(delta) > 12) {
        nav.classList.toggle('is-hidden', delta > 0 && y > 320);
        lastY = y;
      } else if (y < 320) {
        nav.classList.remove('is-hidden');
        lastY = y;
      }
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true }
    );
    update();

    let isOpen = false;
    let closeTimer = 0;

    const setOpen = (open: boolean) => {
      isOpen = open;
      window.clearTimeout(closeTimer);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) {
        menu.hidden = false;
        nav.classList.remove('is-hidden');
        void menu.offsetWidth; // fuerza el estilo inicial para que la transición de entrada se ejecute
        nav.classList.add('is-open');
      } else {
        nav.classList.remove('is-open');
        closeTimer = window.setTimeout(() => {
          if (!isOpen) menu.hidden = true;
        }, 320);
      }
    };

    toggle.addEventListener('click', () => setOpen(!isOpen));
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
