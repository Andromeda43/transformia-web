---
import GridBackground from './ui/GridBackground.astro';
import SectionHeader from './ui/SectionHeader.astro';
---

<section id="servicios" class="servicios-section">
  <GridBackground opacity={0.3} />

  <!-- Efectos de fondo cibernético adicionales -->
  <div class="floating-particles"></div>
  <div class="data-stream"></div>

  <!-- Contenedor principal -->
  <div class="container">
    <SectionHeader
      title="¿QUÉ HACEMOS?"
      subtitle="Transformamos ideas en soluciones digitales de alto impacto"
    />

    <!-- Tarjetas de servicios con animación escalonada -->
    <div class="servicios-cards">
      <!-- Tarjeta 1: Observamos -->
      <div class="servicio-card" data-color="purple">
        <div class="card-content">
          <div class="hover-indicator top-left"></div>
          <div class="hover-indicator top-right"></div>
          <div class="hover-indicator bottom-left"></div>
          <div class="hover-indicator bottom-right"></div>
          
          <div class="servicio-icon-container">
            <div class="icon-background"></div>
            <div class="servicio-icon purple">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </div>
            <div class="icon-pulse"></div>
          </div>
          
          <h3 class="servicio-title">Observamos</h3>
          <p class="servicio-description">
            Antes de escribir una línea de código, mapeamos tus procesos reales.
            El resultado: sabes exactamente dónde estás perdiendo tiempo y dinero,
            con datos — no con suposiciones.
          </p>
          
          <div class="tech-details">
            <div class="tech-badge">Análisis de Datos</div>
            <div class="tech-badge">UX Research</div>
            <div class="tech-badge">Business Intelligence</div>
          </div>
        </div>
        
        <div class="card-footer">
          <div class="energy-bar">
            <div class="energy-level"></div>
          </div>
        </div>
        
        <!-- Elementos decorativos -->
        <div class="circuit-lines"></div>
        <div class="glow-effect"></div>
      </div>
      
      <!-- Tarjeta 2: Diseñamos -->
      <div class="servicio-card" data-color="blue">
        <div class="card-content">
          <div class="hover-indicator top-left"></div>
          <div class="hover-indicator top-right"></div>
          <div class="hover-indicator bottom-left"></div>
          <div class="hover-indicator bottom-right"></div>
          
          <div class="servicio-icon-container">
            <div class="icon-background"></div>
            <div class="servicio-icon blue">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
            </div>
            <div class="icon-pulse"></div>
          </div>
          
          <h3 class="servicio-title">Diseñamos</h3>
          <p class="servicio-description">
            Diseño centrado en quien realmente usa el sistema todos los días,
            no en lo que se ve bien en una presentación. Menos capacitación,
            más adopción desde el primer día.
          </p>
          
          <div class="tech-details">
            <div class="tech-badge">UI/UX Design</div>
            <div class="tech-badge">Arquitectura</div>
            <div class="tech-badge">Prototipado</div>
          </div>
        </div>
        
        <div class="card-footer">
          <div class="energy-bar">
            <div class="energy-level"></div>
          </div>
        </div>
        
        <!-- Elementos decorativos -->
        <div class="circuit-lines"></div>
        <div class="glow-effect"></div>
      </div>
      
      <!-- Tarjeta 3: Desarrollamos -->
      <div class="servicio-card" data-color="pink">
        <div class="card-content">
          <div class="hover-indicator top-left"></div>
          <div class="hover-indicator top-right"></div>
          <div class="hover-indicator bottom-left"></div>
          <div class="hover-indicator bottom-right"></div>
          
          <div class="servicio-icon-container">
            <div class="icon-background"></div>
            <div class="servicio-icon pink">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
              </svg>
            </div>
            <div class="icon-pulse"></div>
          </div>
          
          <h3 class="servicio-title">Desarrollamos</h3>
          <p class="servicio-description">
            Construimos pensando en cómo vas a operar en un año, no solo en
            el día del lanzamiento. El resultado: una base sólida que soporta
            más usuarios y funcionalidades sin que haya que reescribirla desde cero.
          </p>
          
          <div class="tech-details">
            <div class="tech-badge">Web</div>
            <div class="tech-badge">Mobile</div>
            <div class="tech-badge">Cloud</div>
          </div>
        </div>
        
        <div class="card-footer">
          <div class="energy-bar">
            <div class="energy-level"></div>
          </div>
        </div>
        
        <!-- Elementos decorativos -->
        <div class="circuit-lines"></div>
        <div class="glow-effect"></div>
      </div>
      
      <!-- Tarjeta 4: Optimizamos -->
      <div class="servicio-card" data-color="yellow">
        <div class="card-content">
          <div class="hover-indicator top-left"></div>
          <div class="hover-indicator top-right"></div>
          <div class="hover-indicator bottom-left"></div>
          <div class="hover-indicator bottom-right"></div>
          
          <div class="servicio-icon-container">
            <div class="icon-background"></div>
            <div class="servicio-icon yellow">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <div class="icon-pulse"></div>
          </div>
          
          <h3 class="servicio-title">Optimizamos</h3>
          <p class="servicio-description">
            No optimizamos para un número en un reporte: vigilamos tu sistema
            en producción y corregimos antes de que una falla te cueste
            clientes. Menos incidentes sorpresa, más tranquilidad para tu equipo.
          </p>
          
          <div class="tech-details">
            <div class="tech-badge">Performance</div>
            <div class="tech-badge">Seguridad</div>
            <div class="tech-badge">DevOps</div>
          </div>
        </div>
        
        <div class="card-footer">
          <div class="energy-bar">
            <div class="energy-level"></div>
          </div>
        </div>
        
        <!-- Elementos decorativos -->
        <div class="circuit-lines"></div>
        <div class="glow-effect"></div>
      </div>
      
      <!-- Tarjeta 5 NUEVA: Integramos -->
      <div class="servicio-card" data-color="green">
        <div class="card-content">
          <div class="hover-indicator top-left"></div>
          <div class="hover-indicator top-right"></div>
          <div class="hover-indicator bottom-left"></div>
          <div class="hover-indicator bottom-right"></div>
          
          <div class="servicio-icon-container">
            <div class="icon-background"></div>
            <div class="servicio-icon green">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" viewBox="0 0 24 24" stroke="#42ff66">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
              </svg>
            </div>
            <div class="icon-pulse"></div>
          </div>
          
          <h3 class="servicio-title">Integramos</h3>
          <p class="servicio-description">
            Tu software no vive aislado: lo conectamos con básculas, sensores
            y equipos que ya usas en planta o en tienda. Menos digitación
            manual, menos errores, información real llegando sola al sistema.
          </p>
          
          <div class="tech-details">
            <div class="tech-badge">IoT</div>
            <div class="tech-badge">Hardware</div>
            <div class="tech-badge">Sensores</div>
          </div>
        </div>
        
        <div class="card-footer">
          <div class="energy-bar">
            <div class="energy-level"></div>
          </div>
        </div>
        
        <!-- Elementos decorativos -->
        <div class="circuit-lines"></div>
        <div class="glow-effect"></div>
      </div>
    </div>
    
    <!-- Sección de "Desarrollo a medida" destacada -->
    <div class="desarrollo-destacado">
      <div class="highlight-container">
        <div class="highlight-header">
          <h3 class="highlight-title">DESARROLLO A MEDIDA</h3>
          <div class="tech-line"></div>
        </div>
        
        <div class="highlight-content">
          <div class="highlight-text">
            <p>Creamos soluciones tecnológicas personalizadas que se adaptan perfectamente a las necesidades específicas de tu empresa:</p>
            
            <ul class="feature-list">
              <li class="feature-item">
                <div class="feature-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <span>Aplicaciones web de alto rendimiento con tecnologías modernas</span>
              </li>
              <li class="feature-item">
                <div class="feature-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <span>Aplicaciones móviles nativas y multiplataforma</span>
              </li>
              <li class="feature-item">
                <div class="feature-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <span>Desarrollo de APIs e integración con sistemas existentes</span>
              </li>
              <li class="feature-item">
                <div class="feature-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <span>Soluciones de e-commerce y sistemas de gestión empresarial</span>
              </li>
              <li class="feature-item">
                <div class="feature-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <span>Arquitecturas cloud escalables y de alta disponibilidad</span>
              </li>
              <li class="feature-item">
                <div class="feature-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <span>Integración con componentes físicos y periféricos externos</span>
              </li>
            </ul>
          </div>
          
          <div class="tech-stack">
            <div class="stack-header">TECNOLOGÍAS</div>
            <div class="tech-grid">
              <div class="tech-item">
                <div class="tech-icon" data-tech="frontend"></div>
                <span>Frontend</span>
              </div>
              <div class="tech-item">
                <div class="tech-icon" data-tech="backend"></div>
                <span>Backend</span>
              </div>
              <div class="tech-item">
                <div class="tech-icon" data-tech="mobile"></div>
                <span>Mobile</span>
              </div>
              <div class="tech-item">
                <div class="tech-icon" data-tech="iot"></div>
                <span>IoT</span>
              </div>
              <div class="tech-item">
                <div class="tech-icon" data-tech="database"></div>
                <span>Database</span>
              </div>
              <div class="tech-item">
                <div class="tech-icon" data-tech="ai"></div>
                <span>AI/ML</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Paleta compartida vía tokens.css (--neon-purple, --neon-blue, --neon-pink, --neon-yellow, --neon-green) */

  /* Estilos principales */
  .servicios-section {
    position: relative;
    background-color: #0a0a14;
    color: white;
    padding: 6rem 0;
    overflow: hidden;
    min-height: 100vh;
    z-index: 1;
  }
  
  .container {
    width: 95%; /* Aumentado para dar más espacio */
    max-width: 1400px; /* Aumentado para permitir tarjetas más anchas */
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }
  
  /* Efectos de fondo cibernético adicionales (el patrón de grid lo aporta GridBackground) */
  .floating-particles {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: radial-gradient(rgba(128, 90, 213, 0.2) 1px, transparent 1px);
    background-size: 60px 60px;
    opacity: 0.5;
    z-index: 0;
    animation: floatParticles 120s linear infinite;
  }
  
  @keyframes floatParticles {
    0% {
      background-position: 0 0;
    }
    100% {
      background-position: 100px 100px;
    }
  }
  
  .data-stream {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0.1;
    background: url("data:image/svg+xml,%3Csvg width='100' height='100' xmlns='http://www.w3.org/2000/svg'%3E%3Ctext x='10' y='50' font-family='monospace' font-size='10' fill='%23b042ff'%3E01001%3C/text%3E%3Ctext x='50' y='20' font-family='monospace' font-size='10' fill='%234287ff'%3E10101%3C/text%3E%3Ctext x='30' y='80' font-family='monospace' font-size='10' fill='%23ff42b0'%3E11010%3C/text%3E%3C/svg%3E");
    animation: dataStream 60s linear infinite;
    z-index: 0;
  }
  
  @keyframes dataStream {
    0% {
      background-position: 0 0;
    }
    100% {
      background-position: 1000px 1000px;
    }
  }
  
  /* Tarjetas de servicios */
  .servicios-cards {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 2rem;
    margin-bottom: 5rem;
  }
  
  @media (min-width: 640px) {
    .servicios-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (min-width: 1024px) {
    .servicios-cards {
      grid-template-columns: repeat(5, 1fr);
    }
  }
  
  .servicio-card {
    position: relative;
    background: rgba(26, 20, 45, 0.5);
    backdrop-filter: blur(10px);
    border-radius: 10px;
    border: 1px solid rgba(176, 66, 255, 0.2);
    overflow: hidden;
    transition: box-shadow 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), border-color 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  /* Colores de tarjetas */
  .servicio-card[data-color="purple"] {
    --card-color: var(--neon-purple);
  }

  .servicio-card[data-color="blue"] {
    --card-color: var(--neon-blue);
  }

  .servicio-card[data-color="pink"] {
    --card-color: var(--neon-pink);
  }

  .servicio-card[data-color="yellow"] {
    --card-color: var(--neon-yellow);
  }

  .servicio-card[data-color="green"] {
    --card-color: var(--neon-green, #42ff66);
  }

  .servicio-card:hover {
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3), 0 0 25px rgba(var(--card-color), 0.2);
    border-color: var(--card-color);
    z-index: 3;
  }
  
  .card-content {
    padding: 2rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 2;
  }
  
  /* Iconos de las tarjetas */
  .servicio-icon-container {
    position: relative;
    width: 80px;
    height: 80px;
    margin: 0 auto 1.5rem;
  }
  
  .icon-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(176, 66, 255, 0.1);
    border-radius: 50%;
    z-index: 1;
    transition: all 0.3s ease;
  }
  
  .servicio-icon {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    z-index: 2;
    transition: all 0.4s ease;
    color: var(--neon-purple);
  }
  
  .servicio-icon.blue {
    color: var(--neon-blue);
  }
  
  .servicio-icon.pink {
    color: var(--neon-pink);
  }
  
  .servicio-icon.yellow {
    color: var(--neon-yellow);
  }
  
  .icon-pulse {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 2px solid var(--card-color);
    opacity: 0;
    z-index: 3;
    animation: iconPulse 2s infinite;
    transform-origin: center center;
    transform: translate(-50%, -50%);
  }
  
  @keyframes iconPulse {
    0% {
      transform: translate(-50%, -50%) scale(0.5);
      opacity: 0.7;
    }
    100% {
      transform: translate(-50%, -50%) scale(1.5);
      opacity: 0;
    }
  }
  
  .servicio-card:hover .servicio-icon {
    transform: scale(1.1) rotate(5deg);
    filter: drop-shadow(0 0 15px var(--card-color));
  }
  
  .servicio-card:hover .icon-background {
    transform: scale(1.2);
    background: rgba(var(--card-color), 0.2);
  }
  
  /* Títulos y descripciones */
  .servicio-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: white;
    margin-bottom: 1rem;
    text-align: center;
    font-family: var(--font-mono);
    letter-spacing: 1px;
    transition: all 0.3s ease;
  }
  
  .servicio-card:hover .servicio-title {
    color: var(--card-color);
    text-shadow: 0 0 10px var(--card-color);
  }
  
  .servicio-description {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.6;
    text-align: center;
    margin-bottom: 1.5rem;
    flex-grow: 1;
    font-family: var(--font-body);
  }
  
  /* Badges tecnológicas */
  .tech-details {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: auto;
  }
  
  .tech-badge {
    background: rgba(176, 66, 255, 0.1);
    border: 1px solid rgba(176, 66, 255, 0.3);
    border-radius: 20px;
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.9);
    transition: all 0.3s ease;
    font-family: var(--font-mono);
  }
  
  .servicio-card:hover .tech-badge {
    background: rgba(var(--card-color), 0.2);
    border-color: var(--card-color);
    color: white;
    transform: scale(1.05);
  }
  
  /* Pie de tarjeta con barra de energía */
  .card-footer {
    padding: 0.75rem 2rem;
    background: rgba(0, 0, 0, 0.2);
    position: relative;
  }
  
  .energy-bar {
    height: 3px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 2px;
    overflow: hidden;
  }
  
  .energy-level {
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, 
      var(--neon-purple) 0%, 
      var(--neon-blue) 50%, 
      var(--neon-purple) 100%
    );
    background-size: 200% 100%;
    animation: energyFlow 3s infinite linear;
    transition: width 0.5s ease-in-out;
  }
  
  .servicio-card:hover .energy-level {
    width: 100%;
  }
  
  @keyframes energyFlow {
    0% {
      background-position: 0% 50%;
    }
    100% {
      background-position: 200% 50%;
    }
  }
  
  /* Elementos decorativos */
  .circuit-lines {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath stroke='%23b042ff' stroke-width='0.5' fill='none' d='M15,15 L85,15 L85,85 L15,85 Z M30,15 L30,30 L15,30 M55,15 L55,30 L70,30 L70,15 M85,45 L70,45 L70,70 L45,70 L45,85 M15,60 L30,60 L30,85'/%3E%3Ccircle cx='40' cy='40' r='3' fill='%23b042ff'/%3E%3Ccircle cx='20' cy='25' r='2' fill='%23b042ff'/%3E%3Ccircle cx='60' cy='25' r='2' fill='%23b042ff'/%3E%3Ccircle cx='20' cy='55' r='2' fill='%23b042ff'/%3E%3Ccircle cx='60' cy='55' r='2' fill='%23b042ff'/%3E%3C/svg%3E");
    background-size: 200px 200px;
    background-position: center;
    opacity: 0.05;
    z-index: 0;
    transition: opacity 0.3s ease;
  }
  
  .servicio-card:hover .circuit-lines {
    opacity: 0.15;
  }
  
  .glow-effect {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 50% 50%, rgba(176, 66, 255, 0.1) 0%, transparent 70%);
