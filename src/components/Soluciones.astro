---
// Componente principal de Soluciones que integra el sistema de tabs y cards
import SolucionesTabCards from './SolucionesComponents/SolucionesTabCards.astro';
import GridBackground from './ui/GridBackground.astro';
import SectionHeader from './ui/SectionHeader.astro';
---

<section id="soluciones" class="soluciones-section">
  <!-- Elemento de transición hacia la sección anterior -->
  <div class="section-transition"></div>

  <GridBackground opacity={0.5} perspective />

  <div class="container">
    <SectionHeader
      title="SOLUCIONES / SERVICIOS"
      badge="ALTA TECNOLOGÍA"
      subtitle="Soluciones digitales de vanguardia que transforman desafíos en oportunidades de crecimiento para tu negocio."
    />

    <!-- Componente de Tabs y Cards -->
    <div class="tab-cards-wrapper">
      <SolucionesTabCards />
    </div>
  </div>

  <!-- Elementos decorativos flotantes -->
  <div class="floating-elements">
    <div class="element el1"></div>
    <div class="element el2"></div>
    <div class="element el3"></div>
    <div class="element el4"></div>
  </div>
</section>

<style>
  /* Variables y estilos base */
  :root {
    --purple: #b042ff;
    --blue: #4287ff;
    --pink: #ff42b0;
    --yellow: #e8ff42;
    --dark-bg: #0a0a14;
    --dark-purple: #1a142d;
  }
  
  .soluciones-section {
    position: relative;
    width: 100%;
    min-height: 100vh;
    background-color: var(--dark-bg);
    color: white;
    padding: 8rem 0 6rem;
    overflow: hidden;
    display: flex;
    justify-content: center; /* Centrar horizontalmente */
    box-sizing: border-box;
  }
  
  /* Transición suave entre secciones */
  .section-transition {
    position: absolute;
    top: -60px;
    left: 0;
    width: 100%;
    height: 120px;
    background: linear-gradient(to bottom, transparent, var(--dark-bg));
    z-index: 3;
  }
  
  .container {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem; /* Padding uniforme */
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center; /* Centrar contenido */
    box-sizing: border-box;
  }
  
  /* Wrapper del nuevo sistema de tabs y cards */
  .tab-cards-wrapper {
    position: relative;
    z-index: 10;
    margin-top: 3rem;
    width: 100%; /* Ancho completo */
    max-width: 1100px; /* Control de ancho máximo */
  }
  
  /* Elementos decorativos flotantes */
  .floating-elements {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    pointer-events: none;
  }
  
  .element {
    position: absolute;
    opacity: 0.6;
    border-radius: 50%;
    animation: float-animation 15s infinite ease-in-out;
  }
  
  .el1 {
    width: 8px;
    height: 8px;
    background: var(--purple);
    top: 20%;
    left: 15%;
    box-shadow: 0 0 10px var(--purple);
  }
  
  .el2 {
    width: 12px;
    height: 12px;
    background: var(--blue);
    bottom: 25%;
    left: 10%;
    box-shadow: 0 0 15px var(--blue);
    animation-delay: 3s;
  }
  
  .el3 {
    width: 10px;
    height: 10px;
    background: var(--pink);
    top: 30%;
    right: 15%;
    box-shadow: 0 0 12px var(--pink);
    animation-delay: 2s;
  }
  
  .el4 {
    width: 14px;
    height: 14px;
    background: var(--yellow);
    bottom: 15%;
    right: 10%;
    box-shadow: 0 0 15px var(--yellow);
    animation-delay: 5s;
  }
  
  @keyframes float-animation {
    0%, 100% {
      transform: translate(0, 0);
    }
    25% {
      transform: translate(15px, -20px);
    }
    50% {
      transform: translate(30px, 0px);
    }
    75% {
      transform: translate(15px, 20px);
    }
  }
  
  /* Responsive */
  @media (max-width: 1200px) {
    .container {
      padding: 0 1.5rem;
    }
  }

  @media (max-width: 992px) {
    .soluciones-section {
      padding: 7rem 0 5rem;
    }

    .container {
      padding: 0 1.25rem;
    }
  }

  @media (max-width: 768px) {
    .soluciones-section {
      padding: 6rem 0 4rem;
    }

    .container {
      padding: 0 1rem;
    }
  }

  @media (max-width: 576px) {
    .soluciones-section {
      padding: 5rem 0 3rem;
    }

    .container {
      padding: 0 0.75rem;
    }

    .element {
      display: none; /* Ocultar elementos decorativos en pantallas muy pequeñas */
    }
  }

  @media (max-width: 375px) {
    .container {
      padding: 0 0.5rem;
    }
  }