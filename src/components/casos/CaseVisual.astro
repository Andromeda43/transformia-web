---
// src/components/casos/CaseVisual.astro — portada visual de cada caso: captura real o UI ilustrativa en CSS.
import { Image } from 'astro:assets';
import type { CasoDeExito } from '../../data/casosDeExito';
import Icon from '../ui/Icon.astro';

interface Props {
  caso: CasoDeExito;
}
const { caso } = Astro.props;
---

<div class:list={['cv', `cv--${caso.visual}`]} aria-hidden="true">
  {caso.visual === 'screenshot' && caso.image && (
    <div class="cv-shot">
      <div class="cv-bar"><i></i><i></i><i></i></div>
      <Image src={caso.image} alt="" widths={[480, 800, 1100]} sizes="(max-width: 900px) 100vw, 640px" loading="lazy" />
    </div>
  )}

  {caso.visual === 'formulacion' && (
    <div class="cv-panel">
      <div class="cv-panel-head mono"><span>Orden 47 · Fórmula F-12</span><span class="cv-live">● en vivo</span></div>
      <div class="cv-batches">
        {[
          { n: 'Bache 01', p: 100, ok: true },
          { n: 'Bache 02', p: 100, ok: true },
          { n: 'Bache 03', p: 64, ok: false },
          { n: 'Bache 04', p: 0, ok: false },
        ].map((b) => (
          <div class="cv-batch">
            <span class="mono">{b.n}</span>
            <span class="cv-bar-track"><span class="cv-bar-fill" style={`--p:${b.p}%`}></span></span>
            <span class:list={['cv-state', { 'is-ok': b.ok }]}>{b.ok ? '✓' : `${b.p}%`}</span>
          </div>
        ))}
      </div>
      <div class="cv-ingredients mono">
        <span>Azúcar · 12,40 kg <b>±0,5%</b></span>
        <span>Pectina · 0,82 kg <b>±0,5%</b></span>
      </div>
    </div>
  )}

  {caso.visual === 'marketplace' && (
    <div class="cv-phones">
      <div class="cv-phone">
        <span class="cv-notch"></span>
        <b class="cv-app">FeriaApp</b>
        <span class="cv-img cv-img--a"></span>
        <span class="cv-line"></span><span class="cv-line cv-line--short"></span>
        <span class="cv-img cv-img--b"></span>
      </div>
      <div class="cv-phone cv-phone--chat">
        <span class="cv-notch"></span>
        <span class="cv-msg">¿Siguen disponibles?</span>
        <span class="cv-msg cv-msg--me">Sí, 25 cabezas</span>
        <span class="cv-msg">Envío solicitud</span>
      </div>
    </div>
  )}

  {caso.visual === 'sitios' && (
    <div class="cv-stack">
      <span class="cv-site cv-site--1"><i></i><b></b><em></em></span>
      <span class="cv-site cv-site--2"><i></i><b></b><em></em></span>
      <span class="cv-site cv-site--3"><i></i><b></b><em></em></span>
    </div>
  )}

  {caso.visual === 'propuesta' && (
    <div class="cv-proposal">
      <div class="cv-node"><Icon name="smartphone" size={16} /><span>Finca · sin conexión</span></div>
      <span class="cv-arrow"></span>
      <div class="cv-node"><Icon name="shield" size={16} /><span>SINIGAN-ICA</span></div>
      <span class="cv-arrow"></span>
      <div class="cv-node"><Icon name="layers" size={16} /><span>QR al consumidor</span></div>
    </div>
  )}
</div>

<style>
  .cv {
    container-type: inline-size;
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    min-height: 220px;
    padding: 1.75rem;
    overflow: hidden;
    background:
      radial-gradient(120% 80% at 50% 0%, rgba(var(--accent-rgb), 0.12), transparent 60%),
      var(--bg-elevated);
  }
  .cv > * {
    transition: transform 0.7s var(--ease-out);
  }
  :global(.case:hover) .cv > * {
    transform: translateY(-6px) scale(1.015);
  }

  /* screenshot */
  .cv--screenshot { align-items: end; padding-bottom: 0; }
  .cv-shot {
    width: 100%;
    border-radius: 10px 10px 0 0;
    border: 1px solid var(--border-strong);
    border-bottom: 0;
    overflow: hidden;
    background: var(--surface-1);
  }
  .cv-bar { display: flex; gap: 5px; padding: 8px 10px; background: var(--surface-2); border-bottom: 1px solid var(--border); }
  .cv-bar i { width: 7px; height: 7px; border-radius: 50%; background: var(--border-strong); }
  .cv-shot :global(img) { width: 100%; height: auto; display: block; }

  /* formulación */
  .cv-panel {
    width: 100%;
    max-width: 420px;
    padding: 1rem;
    border-radius: 12px;
    border: 1px solid var(--border-strong);
    background: var(--surface-1);
  }
  .cv-panel-head { display: flex; justify-content: space-between; font-size: 0.7rem; color: var(--text-muted); margin-bottom: 0.9rem; }
  .cv-live { color: var(--signal); }
  .cv-batches { display: flex; flex-direction: column; gap: 0.55rem; }
  .cv-batch { display: grid; grid-template-columns: 4.2rem 1fr 2.6rem; align-items: center; gap: 0.6rem; font-size: 0.7rem; color: var(--text-subtle); }
  .cv-bar-track { height: 6px; border-radius: 3px; background: var(--surface-3); overflow: hidden; }
  .cv-bar-fill { display: block; width: var(--p); height: 100%; background: linear-gradient(90deg, var(--accent), var(--accent-text)); }
  .cv-state { font-family: var(--font-mono); text-align: right; color: var(--text-muted); }
  .cv-state.is-ok { color: var(--signal); }
  .cv-ingredients { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.9rem; font-size: 0.68rem; color: var(--text-muted); }
  .cv-ingredients span { padding: 0.25rem 0.5rem; border-radius: 6px; background: var(--surface-2); }
  .cv-ingredients b { color: var(--signal); font-weight: 400; }
  @container (max-width: 440px) {
    .cv--formulacion { padding: 1.1rem; }
    .cv-panel { padding: 0.8rem; }
    .cv-panel-head { margin-bottom: 0.6rem; }
    .cv-batches { gap: 0.4rem; }
    .cv-ingredients { display: none; }
  }

  /* marketplace */
  .cv-phones { display: flex; gap: 1rem; align-items: flex-end; }
  .cv-phone {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 7px;
    width: 120px;
    height: 220px;
    padding: 26px 10px 10px;
    border-radius: 22px;
    border: 1px solid var(--border-strong);
    background: var(--surface-1);
  }
  .cv-phone--chat { height: 190px; justify-content: flex-end; }
  .cv-notch { position: absolute; top: 8px; left: 50%; width: 36px; height: 9px; border-radius: 9px; background: #000; transform: translateX(-50%); }
  .cv-app { font-size: 0.72rem; }
  .cv-img { height: 52px; border-radius: 10px; }
  .cv-img--a { background: linear-gradient(135deg, #3b2a5c, var(--accent)); }
  .cv-img--b { background: linear-gradient(135deg, #1f3b35, var(--signal)); opacity: 0.85; }
  .cv-line { height: 6px; border-radius: 3px; background: var(--surface-3); }
  .cv-line--short { width: 60%; }
  .cv-msg { align-self: flex-start; padding: 5px 8px; border-radius: 8px; background: var(--surface-3); font-size: 0.62rem; }
  .cv-msg--me { align-self: flex-end; background: var(--accent); color: #fff; }

  /* sitios */
  .cv-stack { position: relative; width: 100%; max-width: 380px; height: 190px; }
  .cv-site {
    position: absolute;
    width: 70%;
    height: 150px;
    border-radius: 10px;
    border: 1px solid var(--border-strong);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 12px;
  }
  .cv-site i { height: 6px; width: 30%; border-radius: 3px; background: currentColor; opacity: 0.5; }
  .cv-site b { height: 14px; width: 75%; border-radius: 4px; background: currentColor; }
  .cv-site em { flex: 1; border-radius: 6px; background: currentColor; opacity: 0.25; }
  .cv-site--1 { left: 0; top: 0; background: #1d1630; color: #ff9bd2; }
  .cv-site--2 { left: 15%; top: 20px; background: #102a2a; color: #7ef0c8; }
  .cv-site--3 { left: 30%; top: 40px; background: #1c1c28; color: var(--accent-text); box-shadow: -18px 0 40px rgba(0, 0, 0, 0.5); }

  /* propuesta */
  .cv-proposal { display: flex; flex-direction: column; align-items: center; gap: 0.4rem; }
  .cv-node {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 0.9rem;
    border: 1px dashed rgba(var(--warning-rgb), 0.5);
    border-radius: 10px;
    background: var(--surface-1);
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .cv-node :global(svg) { color: var(--warning); }
  .cv-arrow { width: 1px; height: 14px; background: var(--border-strong); }
</style>
