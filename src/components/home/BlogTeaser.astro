---
// src/components/home/BlogTeaser.astro
import { getCollection } from 'astro:content';
import SectionHeader from '../ui/SectionHeader.astro';
import BlogPostCard from '../BlogPostCard.astro';
import Icon from '../ui/Icon.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

{posts.length > 0 && (
  <section class="section section--tight">
    <div class="container">
      <div class="blog-head">
        <SectionHeader eyebrow="06 — Blog" title="Lo que aprendemos construyendo." />
        <a href="/blog" class="link-arrow blog-all" data-reveal>Ver todos los artículos <Icon name="arrow" /></a>
      </div>
      <div>
        {posts.map((entry) => <BlogPostCard entry={entry} />)}
      </div>
    </div>
  </section>
)}

<style>
  .blog-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
  }
  .blog-all {
    flex-shrink: 0;
    margin-bottom: clamp(2.5rem, 2rem + 2vw, 4rem);
  }
  @media (max-width: 720px) {
    .blog-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
    }
  }
</style>
