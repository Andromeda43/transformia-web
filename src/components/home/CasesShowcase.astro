---
// src/components/home/CasesShowcase.astro
import SectionHeader from '../ui/SectionHeader.astro';
import CaseCard from '../casos/CaseCard.astro';
import Icon from '../ui/Icon.astro';
import { casosDeExito } from '../../data/casosDeExito';

const ejecutados = casosDeExito.filter((c) => c.status === 'ejecutado');
const [principal, ...resto] = ejecutados;
const secundarios = resto.slice(0, 3);
---

<section class="section">
  <div class="container">
    <div class="cases-head">
      <SectionHeader
        eyebrow="03 — Casos"
        title="Sistemas que ya están en operación."
        lead="Plantas, marketplaces, sitios web: cada proyecto con su propio problema y la misma forma de trabajar."
      />
      <a href="/casos-de-exito" class="link-arrow cases-all" data-reveal>Ver todos los casos <Icon name="arrow" /></a>
    </div>

    <div class="cases-grid">
      {principal && <CaseCard caso={principal} size="large" />}
      <div class="cases-row">
        {secundarios.map((c) => <CaseCard caso={c} />)}
      </div>
    </div>
  </div>
</section>

<style>
  .cases-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
  }
  .cases-all {
    flex-shrink: 0;
    margin-bottom: clamp(2.5rem, 2rem + 2vw, 4rem);
  }
  .cases-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .cases-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  @media (max-width: 960px) {
    .cases-row {
      grid-template-columns: 1fr;
    }
    .cases-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
    }
  }
</style>
