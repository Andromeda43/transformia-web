---
// src/components/home/HeroDevice.astro
// Cuatro negocios distintos, cuatro tipos de software: web de un hotel → app de logística →
// asistente de IA de una clínica veterinaria → panel de una planta de producción.
//
// Eficiencia: cada pantalla ya está maquetada a su tamaño final y solo se anima con opacity/transform
// (compuesto por la GPU). El "cambio de forma" lo hace un único <rect> SVG que interpola x/y/ancho/alto/radio,
// así no se recalcula el layout del contenido en cada cuadro. Todo se pausa fuera de pantalla.
// Sin JS o con reduced-motion se ve la primera pantalla (hotel) con las cuatro etiquetas.
import Icon from '../ui/Icon.astro';

const estados = [
  { nombre: 'Páginas web', negocio: 'Hotel' },
  { nombre: 'Apps móviles', negocio: 'Logística' },
  { nombre: 'Inteligencia artificial', negocio: 'Clínica veterinaria' },
  { nombre: 'Gestión y datos', negocio: 'Planta de producción' },
];
const barras = [46, 58, 52, 71, 64, 83, 90];
const ruta = 'M18 150 C 40 120, 30 96, 62 88 S 110 70, 104 46 S 132 18, 150 22';
---

<div class="dv" data-dv>
  <div class="dv-stage" data-dv-stage>
    <div class="dv-glows" aria-hidden="true">
      <i class="dv-glow dv-glow--0 is-on" data-dv-glow></i>
      <i class="dv-glow dv-glow--1" data-dv-glow></i>
      <i class="dv-glow dv-glow--2" data-dv-glow></i>
      <i class="dv-glow dv-glow--3" data-dv-glow></i>
    </div>
    <div class="dv-floor" aria-hidden="true"></div>

    <div class="dv-tilt" data-dv-tilt aria-hidden="true">
      <!-- Marco que cambia de forma durante la transición -->
      <svg class="dv-frame" data-dv-frame>
        <defs>
          <linearGradient id="dv-stroke" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="rgba(255,255,255,0.35)" />
            <stop offset="0.45" stop-color="rgba(255,255,255,0.06)" />
            <stop offset="1" stop-color="rgba(176,66,255,0.45)" />
          </linearGradient>
        </defs>
        <rect data-dv-rect x="0" y="0" width="0" height="0" rx="16" />
      </svg>

      <!-- 01 · Web de un hotel -->
      <div class="dv-screen s-web is-active" data-dv-screen>
        <div class="w-bar"><span class="dots"><i></i><i></i><i></i></span><span class="w-url mono">llanosdelsol.co</span></div>
        <div class="w-nav"><b>Llanos del Sol</b><span>Habitaciones</span><span>Experiencias</span><em>Reservar</em></div>
        <div class="w-hero">
          <span class="w-sun"></span>
          <span class="w-hills"></span>
          <div class="w-copy">
            <span class="mono">Hotel · Yopal, Casanare</span>
            <b>Atardeceres que no se olvidan.</b>
          </div>
          <div class="w-book" data-dv-anim>
            <span><em>Llegada</em>14 nov</span>
            <span><em>Salida</em>16 nov</span>
            <span><em>Huéspedes</em>2</span>
            <i>Buscar</i>
          </div>
        </div>
        <div class="w-rooms">
          <span data-dv-anim><i class="r1"></i><b>Suite llanera</b><em class="mono">$ 320.000</em></span>
          <span data-dv-anim><i class="r2"></i><b>Cabaña río</b><em class="mono">$ 280.000</em></span>
          <span data-dv-anim><i class="r3"></i><b>Habitación doble</b><em class="mono">$ 190.000</em></span>
        </div>
      </div>

      <!-- 02 · App de logística -->
      <div class="dv-screen s-app" data-dv-screen>
        <span class="a-notch"></span>
        <div class="a-head"><div><span class="mono">Rutas Express</span><b>Ruta de hoy</b></div><span class="a-badge">8/12</span></div>
        <div class="a-map">
          <svg viewBox="0 0 168 170" preserveAspectRatio="xMidYMid slice">
            <path d="M0 40H168M0 95H168M0 140H168M40 0V170M98 0V170M140 0V170" class="m-street" />
            <path d="M0 70 L168 20 M20 170 L120 0" class="m-street m-street--wide" />
            <path id="dv-route" d={ruta} class="m-route" />
            <circle cx="18" cy="150" r="4" class="m-start" />
            <circle cx="150" cy="22" r="5" class="m-end" />
            <g class="m-truck">
              <circle r="6" class="m-truck-halo" />
              <circle r="3.6" class="m-truck-dot" />
              <animateMotion dur="7s" repeatCount="indefinite" rotate="auto" keyPoints="0;1;1" keyTimes="0;0.85;1" calcMode="linear"><mpath href="#dv-route" /></animateMotion>
            </g>
          </svg>
        </div>
        <div class="a-eta" data-dv-anim><Icon name="truck" size={13} /><div><b>Entrega #18 · Hospital Regional</b><em>Llega en 12 min</em></div></div>
        <div class="a-stops">
          <span data-dv-anim><i class="ok"></i>Droguería Central<em>Entregado</em></span>
          <span data-dv-anim><i class="run"></i>Hospital Regional<em>En camino</em></span>
        </div>
      </div>

      <!-- 03 · Asistente de IA de una clínica veterinaria -->
      <div class="dv-screen s-chat" data-dv-screen>
        <div class="c-head"><span class="c-av">🐾</span><div><b>Clínica Patitas</b><em>Asistente · responde al instante</em></div></div>
        <div class="c-body">
          <p class="c-msg c-me" data-dv-anim>Hola, quiero una cita para Luna 🐶</p>
          <p class="c-msg" data-dv-anim>¡Claro! Mañana tengo estos horarios:</p>
          <div class="c-slots" data-dv-anim><span>9:00</span><span class="is-pick" data-dv-pick>11:30</span><span>4:00 p. m.</span></div>
          <p class="c-msg c-ok" data-dv-anim><Icon name="check" size={12} strokeWidth={2.6} /> Cita confirmada. Te recuerdo por aquí.</p>
        </div>
      </div>

      <!-- 04 · Panel de una planta de producción -->
      <div class="dv-screen s-panel" data-dv-screen>
        <aside class="p-side"><span class="p-logo"></span><i class="is-on"></i><i></i><i></i><i></i></aside>
        <div class="p-main">
          <div class="p-head"><div><span class="mono">Planta Yopal</span><b>Producción de hoy</b></div><span class="p-live"><i></i> en vivo</span></div>
          <div class="p-kpis">
            <div data-dv-anim><span>Producido</span><b class="mono">12.480 kg</b></div>
            <div data-dv-anim><span>Lotes</span><b class="mono">34</b></div>
            <div data-dv-anim><span>Rendimiento</span><b class="mono">96 %</b></div>
          </div>
          <div class="p-chart">
            <span>Kilos por hora</span>
            <div class="p-bars">{barras.map((h) => <i style={`--h:${h}%`} data-dv-bar></i>)}</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="dv-tabs" role="group" aria-label="Software para cualquier tipo de negocio">
    {estados.map((e, i) => (
      <button type="button" class:list={['dv-tab', { 'is-on': i === 0 }]} data-dv-tab={i} aria-pressed={i === 0 ? 'true' : 'false'}>
        <span class="dv-tab-name">{e.nombre}</span>
        <span class="dv-tab-biz mono">{e.negocio}</span>
        <span class="dv-tab-bar"><i data-dv-progress></i></span>
      </button>
    ))}
  </div>
</div>

<style>
  .dv { display: flex; flex-direction: column; gap: 1.4rem; width: 100%; }

  /* ---------- Escenario ---------- */
  .dv-stage {
    position: relative;
    container-type: inline-size;
    width: 100%;
    aspect-ratio: 1 / 0.8;
    perspective: 1600px;
  }
  .dv-glows { position: absolute; inset: 4% 4% 0; pointer-events: none; }
  .dv-glow {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    filter: blur(40px);
    opacity: 0;
    transition: opacity 1.1s var(--ease-out);
  }
  .dv-glow.is-on { opacity: 1; }
  .dv-glow--0 { background: radial-gradient(closest-side, rgba(255, 150, 70, 0.32), rgba(var(--accent-rgb), 0.12) 60%, transparent 75%); }
  .dv-glow--1 { background: radial-gradient(closest-side, rgba(61, 220, 151, 0.28), rgba(40, 120, 255, 0.1) 60%, transparent 75%); }
  .dv-glow--2 { background: radial-gradient(closest-side, rgba(90, 160, 255, 0.32), rgba(var(--accent-rgb), 0.1) 60%, transparent 75%); }
  .dv-glow--3 { background: radial-gradient(closest-side, rgba(var(--accent-rgb), 0.38), transparent 72%); }
  .dv-floor {
    position: absolute;
    left: 14%;
    right: 14%;
    bottom: -3%;
    height: 9%;
    background: radial-gradient(closest-side, rgba(0, 0, 0, 0.6), transparent 75%);
    filter: blur(10px);
    pointer-events: none;
  }
  .dv-tilt { position: absolute; inset: 0; transform-style: preserve-3d; will-change: transform; }
  .dv-frame { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; opacity: 0; pointer-events: none; }
  .dv-frame rect { fill: var(--surface-1); stroke: url(#dv-stroke); stroke-width: 1; }

  /* ---------- Pantallas: cada una a su tamaño final ---------- */
  .dv-screen {
    position: absolute;
    overflow: hidden;
    border-radius: 16px;
    background: var(--surface-1);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.09), 0 40px 80px -30px rgba(0, 0, 0, 0.85), inset 0 1px 0 rgba(255, 255, 255, 0.06);
    font-size: clamp(9px, 2cqw, 13px);
    opacity: 0;
    visibility: hidden;
    will-change: transform, opacity;
  }
  .dv-screen.is-active { opacity: 1; visibility: visible; }
  .s-web { left: 2%; top: 12%; width: 96%; height: 76%; }
  .s-app { left: 30%; top: 1%; width: 40%; height: 98%; border-radius: 34px; }
  .s-chat { left: 18%; top: 8%; width: 64%; height: 84%; border-radius: 24px; }
  .s-panel { left: 2%; top: 11%; width: 96%; height: 78%; }
  .dots { display: flex; gap: 0.45em; }
  .dots i { width: 0.7em; height: 0.7em; border-radius: 50%; background: rgba(255, 255, 255, 0.18); }

  /* 01 · Hotel */
  .s-web { display: flex; flex-direction: column; background: #0f1416; }
  .w-bar { display: flex; align-items: center; gap: 1em; height: 2.5em; padding: 0 1em; background: #161d20; border-bottom: 1px solid rgba(255, 255, 255, 0.06); }
  .w-url { margin-inline: auto; padding: 0.2em 1.4em; border-radius: 0.5em; background: #0b0f11; font-size: 0.78em; color: #7f9aa3; }
  .w-nav { display: flex; align-items: center; gap: 1.5em; padding: 0.8em 1.4em; font-size: 0.82em; color: #b9cdd2; }
  .w-nav b { margin-right: auto; font-size: 1.15em; color: #f6d9b0; letter-spacing: -0.01em; }
  .w-nav em { font-style: normal; padding: 0.4em 1em; border-radius: 99px; background: #f2a65a; color: #2a1606; font-weight: 600; }
  .w-hero {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    margin: 0 1em;
    padding: 1.2em 1.3em;
    border-radius: 1em;
    overflow: hidden;
    background: linear-gradient(180deg, #f6a25c 0%, #e0705a 38%, #6b3f6e 70%, #1f2c3a 100%);
  }
  .w-sun { position: absolute; right: 18%; top: 34%; width: 4.5em; height: 4.5em; border-radius: 50%; background: radial-gradient(circle, #ffe2a8, #ffb366 60%, transparent 70%); }
  .w-hills { position: absolute; left: -5%; right: -5%; bottom: 0; height: 45%; background: radial-gradient(120% 100% at 30% 100%, #13322f 55%, transparent 56%), radial-gradient(90% 90% at 85% 100%, #0f2624 55%, transparent 56%); }
  .w-copy { position: relative; display: flex; flex-direction: column; gap: 0.3em; }
  .w-copy span { font-size: 0.72em; color: rgba(255, 255, 255, 0.85); text-transform: uppercase; letter-spacing: 0.1em; }
  .w-copy b { max-width: 13em; font-size: 1.85em; line-height: 1.05; color: #fff; letter-spacing: -0.03em; text-shadow: 0 2px 20px rgba(0, 0, 0, 0.25); }
  .w-book {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.4em;
    width: fit-content;
    padding: 0.4em;
    border-radius: 0.9em;
    background: rgba(255, 255, 255, 0.94);
    color: #1f2c3a;
    font-size: 0.82em;
  }
  .w-book span { display: flex; flex-direction: column; padding: 0.2em 0.8em; border-right: 1px solid #e3e6e8; line-height: 1.2; }
  .w-book span em { font-style: normal; font-size: 0.75em; color: #7a8790; }
  .w-book i { font-style: normal; padding: 0.6em 1em; border-radius: 0.6em; background: #1f2c3a; color: #fff; font-weight: 600; }
  .w-rooms { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.7em; padding: 0.9em 1em 1em; }
  .w-rooms span { display: flex; flex-direction: column; gap: 0.25em; }
  .w-rooms i { height: 3.2em; border-radius: 0.6em; }
  .r1 { background: linear-gradient(135deg, #7a4a2a, #d99a5b); }
  .r2 { background: linear-gradient(135deg, #1f4a48, #5fa79a); }
  .r3 { background: linear-gradient(135deg, #3a3550, #8c84b8); }
  .w-rooms b { font-size: 0.8em; color: #e8eef0; font-weight: 500; }
  .w-rooms em { font-style: normal; font-size: 0.72em; color: #f2a65a; }

  /* 02 · Logística (teléfono) */
  .s-app { display: flex; flex-direction: column; gap: 0.8em; padding: 3em 1em 1em; background: #0b1210; font-size: clamp(9.5px, 2.2cqw, 14px); }
  .a-notch { position: absolute; top: 0.85em; left: 50%; width: 32%; height: 1.35em; border-radius: 99px; background: #000; transform: translateX(-50%); }
  .a-head { display: flex; justify-content: space-between; align-items: flex-end; }
  .a-head div { display: flex; flex-direction: column; }
  .a-head .mono { font-size: 0.72em; color: #5fd3a0; }
  .a-head b { font-size: 1.35em; letter-spacing: -0.02em; }
  .a-badge { padding: 0.2em 0.7em; border-radius: 99px; background: rgba(61, 220, 151, 0.14); color: #3ddc97; font-size: 0.78em; font-weight: 600; }
  .a-map { position: relative; flex: 1; min-height: 0; border-radius: 1em; overflow: hidden; background: #0f1a17; border: 1px solid rgba(61, 220, 151, 0.15); }
  .a-map svg { width: 100%; height: 100%; display: block; }
  .m-street { stroke: rgba(255, 255, 255, 0.06); stroke-width: 6; fill: none; }
  .m-street--wide { stroke: rgba(255, 255, 255, 0.09); stroke-width: 9; }
  .m-route { fill: none; stroke: #3ddc97; stroke-width: 3; stroke-linecap: round; stroke-dasharray: 6 5; opacity: 0.9; }
  .m-start { fill: #0f1a17; stroke: #3ddc97; stroke-width: 2; }
  .m-end { fill: #3ddc97; }
  .m-truck-halo { fill: rgba(61, 220, 151, 0.25); }
  .m-truck-dot { fill: #fff; stroke: #3ddc97; stroke-width: 2; }
  .a-eta { display: flex; align-items: center; gap: 0.6em; padding: 0.7em 0.8em; border-radius: 0.8em; background: rgba(61, 220, 151, 0.1); border: 1px solid rgba(61, 220, 151, 0.35); color: #3ddc97; }
  .a-eta div { display: flex; flex-direction: column; min-width: 0; line-height: 1.25; }
  .a-eta b { font-size: 0.8em; color: #e9fff5; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .a-eta em { font-style: normal; font-size: 0.75em; }
  .a-stops { display: flex; flex-direction: column; gap: 0.45em; }
  .a-stops span { display: flex; align-items: center; gap: 0.6em; font-size: 0.8em; color: #c8d8d2; }
  .a-stops i { width: 0.65em; height: 0.65em; border-radius: 50%; flex: none; }
  .a-stops i.ok { background: #3ddc97; }
  .a-stops i.run { background: #f5b841; }
  .a-stops em { margin-left: auto; font-style: normal; font-size: 0.85em; color: #6f8a81; }

  /* 03 · Clínica veterinaria (asistente IA) */
  .s-chat { display: flex; flex-direction: column; background: #0c1220; font-size: clamp(9.5px, 2.1cqw, 14px); }
  .c-head { display: flex; align-items: center; gap: 0.8em; padding: 1em 1.2em; border-bottom: 1px solid rgba(90, 160, 255, 0.18); }
  .c-head div { display: flex; flex-direction: column; line-height: 1.25; }
  .c-head em { font-style: normal; font-size: 0.75em; color: #7fb4ff; }
  .c-av { display: grid; place-items: center; width: 2.4em; height: 2.4em; border-radius: 50%; background: linear-gradient(135deg, #5aa0ff, #b042ff); }
  .c-body { flex: 1; display: flex; flex-direction: column; justify-content: flex-end; gap: 0.7em; padding: 1.2em; }
  .c-msg { max-width: 84%; padding: 0.7em 0.95em; border-radius: 1em 1em 1em 0.25em; background: #18223a; font-size: 0.9em; line-height: 1.4; }
  .c-me { align-self: flex-end; border-radius: 1em 1em 0.25em 1em; background: #3d7bff; color: #fff; }
  .c-ok { display: flex; align-items: center; gap: 0.5em; background: rgba(61, 220, 151, 0.12); color: #9ff0c9; border: 1px solid rgba(61, 220, 151, 0.35); }
  .c-slots { display: flex; gap: 0.5em; }
  .c-slots span { padding: 0.45em 0.9em; border-radius: 99px; border: 1px solid rgba(90, 160, 255, 0.4); color: #a9c8ff; font-size: 0.82em; transition: background 0.3s, color 0.3s; }
  .c-slots .is-pick { background: #3d7bff; border-color: #3d7bff; color: #fff; }

  /* 04 · Planta de producción */
  .s-panel { display: flex; background: var(--bg-elevated); }
  .p-side { display: flex; flex-direction: column; align-items: center; gap: 1em; width: 3.8em; padding: 1.2em 0; border-right: 1px solid var(--border); }
  .p-logo { width: 1.7em; height: 1.7em; border-radius: 0.5em; background: var(--accent); margin-bottom: 0.5em; }
  .p-side i { width: 1.5em; height: 1.5em; border-radius: 0.45em; background: var(--surface-3); }
  .p-side i.is-on { background: var(--accent-soft); box-shadow: inset 0 0 0 1px rgba(var(--accent-rgb), 0.6); }
  .p-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1em; padding: 1.2em 1.4em; }
  .p-head { display: flex; justify-content: space-between; align-items: flex-end; }
  .p-head div { display: flex; flex-direction: column; }
  .p-head .mono { font-size: 0.72em; color: var(--accent-text); }
  .p-head b { font-size: 1.2em; }
  .p-live { display: inline-flex; align-items: center; gap: 0.4em; font-size: 0.78em; color: var(--signal); }
  .p-live i { width: 0.55em; height: 0.55em; border-radius: 50%; background: var(--signal); }
  .p-kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.8em; }
  .p-kpis div { padding: 0.8em 0.9em; border-radius: 0.8em; border: 1px solid var(--border); background: var(--surface-1); min-width: 0; }
  .p-kpis span { display: block; font-size: 0.75em; color: var(--text-subtle); }
  .p-kpis b { font-size: 1.25em; white-space: nowrap; }
  .p-chart { flex: 1; display: flex; flex-direction: column; gap: 0.6em; padding: 0.9em 1em; border-radius: 0.8em; border: 1px solid var(--border); background: var(--surface-1); }
  .p-chart > span { font-size: 0.75em; color: var(--text-subtle); }
  .p-bars { flex: 1; display: flex; align-items: flex-end; gap: 0.7em; }
  .p-bars i { flex: 1; height: var(--h); border-radius: 0.35em 0.35em 0 0; background: linear-gradient(180deg, var(--accent-text), var(--accent)); transform-origin: bottom; }

  /* ---------- Etiquetas ---------- */
  .dv-tabs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem; }
  .dv-tab { display: flex; flex-direction: column; align-items: flex-start; gap: 0.15rem; text-align: left; color: var(--text-subtle); transition: color var(--dur); }
  .dv-tab:hover { color: var(--text-muted); }
  .dv-tab.is-on { color: var(--text); }
  .dv-tab-name { font-size: 0.9rem; line-height: 1.25; }
  .dv-tab-biz { font-size: 0.7rem; opacity: 0.75; }
  .dv-tab.is-on .dv-tab-biz { color: var(--accent-text); opacity: 1; }
  .dv-tab-bar { width: 100%; height: 2px; margin-top: 0.5rem; border-radius: 2px; background: var(--border); overflow: hidden; }
  .dv-tab-bar i { display: block; height: 100%; background: var(--accent); transform: scaleX(0); transform-origin: left; }
  .dv-tab.is-on .dv-tab-bar i { transform: scaleX(1); }

  @media (max-width: 560px) {
    .dv-stage { aspect-ratio: 1 / 0.95; }
    .s-web { left: 1%; top: 12%; width: 98%; height: 76%; }
    .s-app { left: 24%; width: 52%; }
    .s-chat { left: 8%; top: 6%; width: 84%; height: 88%; }
    .s-panel { left: 1%; top: 10%; width: 98%; height: 80%; }
    .w-rooms { display: none; }
    .w-book span:nth-child(3) { display: none; }
    .dv-tabs { grid-template-columns: repeat(2, 1fr); row-gap: 1rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .m-truck { display: none; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { reduceMotion, finePointer } from '../../scripts/env';

  const HOLD = 4; // segundos en cada estado

  document.querySelectorAll<HTMLElement>('[data-dv]').forEach((root) => {
    const stage = root.querySelector<HTMLElement>('[data-dv-stage]')!;
    const tilt = root.querySelector<HTMLElement>('[data-dv-tilt]')!;
    const frame = root.querySelector<SVGSVGElement>('[data-dv-frame]')!;
    const rect = root.querySelector<SVGRectElement>('[data-dv-rect]')!;
    const screens = Array.from(root.querySelectorAll<HTMLElement>('[data-dv-screen]'));
    const glows = Array.from(root.querySelectorAll<HTMLElement>('[data-dv-glow]'));
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dv-tab]'));
    const bars = tabs.map((t) => t.querySelector<HTMLElement>('[data-dv-progress]')!);
    const pick = root.querySelector<HTMLElement>('[data-dv-pick]');

    let current = 0;
    let visible = false;
    let started = false;
    let progress: gsap.core.Tween | null = null;
    let morph: gsap.core.Timeline | null = null;

    // Geometría real de una pantalla dentro del escenario (la define el CSS, no el JS).
    // offsetLeft/Top usan el layout sin transformar, así la inclinación con el cursor no afecta la medida.
    const geom = (el: HTMLElement) => ({
      x: el.offsetLeft,
      y: el.offsetTop,
      width: el.offsetWidth,
      height: el.offsetHeight,
      rx: parseFloat(getComputedStyle(el).borderTopLeftRadius) || 16,
    });
    const setFrame = () => frame.setAttribute('viewBox', `0 0 ${stage.clientWidth} ${stage.clientHeight}`);

    const setUi = (i: number) => {
      tabs.forEach((t, j) => {
        t.classList.toggle('is-on', j === i);
        t.setAttribute('aria-pressed', String(j === i));
      });
      glows.forEach((g, j) => g.classList.toggle('is-on', j === i));
    };

    // Mini animación propia de cada pantalla (solo opacity/transform).
    const micro = (i: number) => {
      const s = screens[i];
      const items = s.querySelectorAll('[data-dv-anim]');
      const tl = gsap.timeline();
      if (i === 2) {
        pick?.classList.remove('is-pick');
        tl.fromTo(items, { autoAlpha: 0, y: 10 }, { autoAlpha: 1, y: 0, duration: 0.45, stagger: 0.6, ease: 'power3.out' }).call(
          () => pick?.classList.add('is-pick'),
          [],
          1.5
        );
      } else {
        tl.fromTo(items, { autoAlpha: 0, y: 10 }, { autoAlpha: 1, y: 0, duration: 0.5, stagger: 0.1, ease: 'power3.out' });
      }
      if (i === 3) tl.fromTo(s.querySelectorAll('[data-dv-bar]'), { scaleY: 0 }, { scaleY: 1, duration: 0.8, stagger: 0.06, ease: 'power3.out' }, 0.15);
      return tl;
    };

    const startProgress = () => {
      progress?.kill();
      progress = gsap.fromTo(
        bars[current],
        { scaleX: 0 },
        {
          scaleX: 1,
          duration: HOLD,
          ease: 'none',
          paused: !visible || document.hidden,
          onComplete: () => goTo((current + 1) % screens.length),
        }
      );
    };

    function goTo(next: number) {
      if (next === current) return;
      const prev = screens[current];
      const target = screens[next];
      current = next;
      setUi(next);
      morph?.kill();
      progress?.kill();
      progress = null;
      bars.forEach((b, j) => gsap.set(b, { scaleX: j < next ? 1 : 0 }));

      if (reduceMotion) {
        screens.forEach((s) => {
          s.classList.toggle('is-active', s === target);
          gsap.set(s, { clearProps: 'opacity,visibility,transform' });
        });
        return;
      }

      const a = geom(prev);
      const b = geom(target);
      setFrame();
      morph = gsap
        .timeline({ defaults: { overwrite: 'auto' } })
        // El marco toma la forma de la pantalla que sale y aparece debajo de ella.
        .set(rect, { attr: { x: a.x, y: a.y, width: a.width, height: a.height, rx: a.rx } })
        .set(frame, { opacity: 1 })
        .to(prev, { autoAlpha: 0, scale: 0.985, duration: 0.3, ease: 'power2.in' })
        // Cambio de forma: solo el rectángulo SVG.
        .to(rect, { attr: { x: b.x, y: b.y, width: b.width, height: b.height, rx: b.rx }, duration: 0.85, ease: 'expo.inOut' }, 0.12)
        .call(() => {
          prev.classList.remove('is-active');
          target.classList.add('is-active');
        })
        .fromTo(target, { autoAlpha: 0, scale: 1.015 }, { autoAlpha: 1, scale: 1, duration: 0.45, ease: 'power2.out' }, '-=0.18')
        .set(frame, { opacity: 0 })
        .add(() => {
          micro(next);
          startProgress();
        }, '-=0.25');
    }

    tabs.forEach((tab, i) => tab.addEventListener('click', () => goTo(i)));

    if (reduceMotion) {
      root.querySelectorAll('svg').forEach((s) => s.pauseAnimations?.());
      return;
    }

    // Solo avanza (y anima el mapa) mientras se ve.
    const mapSvg = root.querySelector<SVGSVGElement>('.a-map svg');
    const sync = () => {
      const run = visible && !document.hidden;
      if (progress) run ? progress.play() : progress.pause();
      if (mapSvg) run ? mapSvg.unpauseAnimations() : mapSvg.pauseAnimations();
    };
    new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        if (visible && !started) {
          started = true;
          micro(current);
          startProgress();
        }
        sync();
      },
      { threshold: 0.3 }
    ).observe(stage);
    document.addEventListener('visibilitychange', sync);

    // Inclinación sutil con el cursor (transform compuesto).
    if (finePointer) {
      const rx = gsap.quickTo(tilt, 'rotationX', { duration: 0.9, ease: 'power3.out' });
      const ry = gsap.quickTo(tilt, 'rotationY', { duration: 0.9, ease: 'power3.out' });
      stage.addEventListener('pointermove', (e) => {
        const r = stage.getBoundingClientRect();
        ry(((e.clientX - r.left) / r.width - 0.5) * 6);
        rx(-((e.clientY - r.top) / r.height - 0.5) * 5);
      });
      stage.addEventListener('pointerleave', () => {
        rx(0);
        ry(0);
      });
    }

    if (import.meta.env.DEV) (window as any).__device = { goTo, get current() { return current; } };
  });
</script>
