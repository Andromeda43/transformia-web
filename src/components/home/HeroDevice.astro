---
// src/components/home/HeroDevice.astro
// Un solo dispositivo que se transforma: navegador → teléfono → chat con IA → panel de gestión.
// La pieza cambia de forma (ancho, alto y radio) y su contenido hace un fundido. Debajo, las cuatro
// etiquetas nombran cada producto; se pueden tocar para saltar a uno. Sin JS o con reduced-motion
// se ve el primer estado (página web) con las cuatro etiquetas visibles.
import Icon from '../ui/Icon.astro';

const estados = [
  { id: 'web', nombre: 'Páginas web' },
  { id: 'app', nombre: 'Apps móviles' },
  { id: 'ia', nombre: 'Inteligencia artificial' },
  { id: 'panel', nombre: 'Gestión y datos' },
];
const barras = [38, 55, 47, 70, 62, 84, 76];
---

<div class="dv" data-dv>
  <div class="dv-stage" data-dv-stage>
    <div class="dv-glow" aria-hidden="true"></div>
    <div class="dv-floor" aria-hidden="true"></div>

    <div class="dv-device" data-dv-device aria-hidden="true">
      <!-- 01 · Página web -->
      <div class="dv-screen dv-web is-active" data-dv-screen="0">
        <div class="w-bar"><span class="dots"><i></i><i></i><i></i></span><span class="w-url mono">cafeorigen.co</span></div>
        <div class="w-nav"><b>Café Origen</b><span>Tienda</span><span>Nosotros</span><span class="w-cart"><Icon name="cart" size={12} /></span></div>
        <div class="w-hero">
          <div class="w-copy">
            <span class="w-kicker mono">Desde el Llano</span>
            <b data-dv-anim>Café de origen, directo de la finca.</b>
            <span data-dv-anim>Tostado cada semana y enviado a todo el país.</span>
            <span class="w-btns" data-dv-anim><em class="w-btn">Comprar ahora</em><em class="w-btn w-btn--ghost">Ver catálogo</em></span>
          </div>
          <div class="w-img" data-dv-anim></div>
        </div>
        <div class="w-cards">
          <span class="w-card" data-dv-anim><i class="w-c1"></i><b>Tostado medio</b><em class="mono">$ 38.000</em></span>
          <span class="w-card" data-dv-anim><i class="w-c2"></i><b>Molido fino</b><em class="mono">$ 36.000</em></span>
          <span class="w-card" data-dv-anim><i class="w-c3"></i><b>Kit regalo</b><em class="mono">$ 89.000</em></span>
        </div>
      </div>

      <!-- 02 · App móvil -->
      <div class="dv-screen dv-app" data-dv-screen="1">
        <span class="a-notch"></span>
        <div class="a-head"><b>Pedidos</b><span class="a-av">LM</span></div>
        <div class="a-search"><Icon name="search" size={11} /> Buscar pedido</div>
        <div class="a-toast" data-dv-anim><i></i> Nuevo pedido #1044</div>
        <div class="a-list">
          <span class="a-item" data-dv-anim><b>#1044 · Comercial Yopal</b><em class="a-run">Nuevo</em></span>
          <span class="a-item" data-dv-anim><b>#1043 · Agro del Llano</b><em class="a-ok">Entregado</em></span>
          <span class="a-item" data-dv-anim><b>#1042 · La Casona</b><em class="a-wait">En ruta</em></span>
        </div>
        <div class="a-tabs"><i class="is-on"></i><i></i><i></i><i></i></div>
      </div>

      <!-- 03 · Chat con IA -->
      <div class="dv-screen dv-chat" data-dv-screen="2">
        <div class="c-head"><span class="c-av"><Icon name="sparkles" size={13} /></span><div><b>Asistente</b><em>en línea · responde al instante</em></div></div>
        <div class="c-body">
          <p class="c-msg c-msg--me" data-dv-anim>¿Tienen envíos a Yopal?</p>
          <p class="c-msg" data-dv-anim>¡Sí! Llega en 2 días hábiles. ¿Te comparto el catálogo?</p>
          <p class="c-msg c-msg--me" data-dv-anim>Sí, por favor 🙌</p>
          <div class="c-card" data-dv-anim><i></i><div><b>Tostado medio · 500 g</b><em class="mono">$ 38.000</em></div><span>Pedir</span></div>
        </div>
      </div>

      <!-- 04 · Panel de gestión -->
      <div class="dv-screen dv-panel" data-dv-screen="3">
        <aside class="p-side"><span class="p-logo"></span><i class="is-on"></i><i></i><i></i><i></i></aside>
        <div class="p-main">
          <div class="p-head"><b>Panel general</b><span class="p-live"><i></i> en vivo</span></div>
          <div class="p-kpis">
            <div data-dv-anim><span>Pedidos hoy</span><b class="mono">42</b></div>
            <div data-dv-anim><span>Ventas del mes</span><b class="mono">$ 86 M</b></div>
            <div data-dv-anim><span>A tiempo</span><b class="mono">96 %</b></div>
          </div>
          <div class="p-chart"><span>Ventas por semana</span><div class="p-bars">{barras.map((h) => <i style={`--h:${h}%`} data-dv-bar></i>)}</div></div>
        </div>
      </div>
    </div>
  </div>

  <div class="dv-tabs" role="group" aria-label="Lo que construimos">
    {estados.map((e, i) => (
      <button type="button" class:list={['dv-tab', { 'is-on': i === 0 }]} data-dv-tab={i} aria-pressed={i === 0 ? 'true' : 'false'}>
        <span class="dv-tab-n mono">{String(i + 1).padStart(2, '0')}</span>
        <span class="dv-tab-name">{e.nombre}</span>
        <span class="dv-tab-bar"><i data-dv-progress></i></span>
      </button>
    ))}
  </div>
</div>

<style>
  .dv {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: 100%;
  }

  /* ---------- Escenario ---------- */
  .dv-stage {
    position: relative;
    container-type: inline-size;
    width: 100%;
    aspect-ratio: 1 / 0.78;
    perspective: 1600px;
  }
  .dv-glow {
    position: absolute;
    inset: 8% 6% 4%;
    background: radial-gradient(closest-side, rgba(var(--accent-rgb), 0.3), transparent 72%);
    filter: blur(34px);
    pointer-events: none;
  }
  .dv-floor {
    position: absolute;
    left: 15%;
    right: 15%;
    bottom: -2%;
    height: 10%;
    background: radial-gradient(closest-side, rgba(0, 0, 0, 0.55), transparent 75%);
    filter: blur(10px);
    pointer-events: none;
  }

  /* ---------- Dispositivo (forma inicial: navegador) ---------- */
  .dv-device {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 96%;
    height: 74%;
    border-radius: 16px;
    transform: translate(-50%, -50%);
    background: var(--surface-1);
    box-shadow:
      0 0 0 1px var(--border-strong),
      0 40px 80px -30px rgba(0, 0, 0, 0.8),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
    overflow: hidden;
    font-size: clamp(9px, 2.05cqw, 13px);
    will-change: width, height, border-radius;
  }
  .dv-screen {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
  }
  .dv-screen.is-active {
    opacity: 1;
    visibility: visible;
  }
  .dots { display: flex; gap: 0.45em; }
  .dots i { width: 0.7em; height: 0.7em; border-radius: 50%; background: var(--border-strong); }

  /* 01 · Web */
  .dv-web { display: flex; flex-direction: column; background: #120f0c; }
  .w-bar { display: flex; align-items: center; gap: 1em; height: 2.6em; padding: 0 1em; background: var(--surface-2); border-bottom: 1px solid var(--border); }
  .w-url { margin-inline: auto; padding: 0.2em 1.4em; border-radius: 0.5em; background: var(--bg); font-size: 0.8em; color: var(--text-subtle); }
  .w-nav { display: flex; align-items: center; gap: 1.6em; padding: 0.9em 1.5em; font-size: 0.85em; color: #cdb9a4; }
  .w-nav b { margin-right: auto; font-size: 1.15em; color: #f0c48a; letter-spacing: -0.01em; }
  .w-cart { display: grid; place-items: center; width: 2em; height: 2em; border-radius: 50%; background: rgba(240, 196, 138, 0.12); color: #f0c48a; }
  .w-hero { flex: 1; display: grid; grid-template-columns: 1.15fr 1fr; gap: 1.4em; align-items: center; padding: 0.4em 1.5em 1em; }
  .w-copy { display: flex; flex-direction: column; gap: 0.6em; }
  .w-kicker { font-size: 0.72em; color: #f0a35e; text-transform: uppercase; letter-spacing: 0.1em; }
  .w-copy b { font-size: 1.95em; line-height: 1.05; letter-spacing: -0.03em; color: #fff3e4; }
  .w-copy > span:not(.w-kicker):not(.w-btns) { font-size: 0.88em; color: #bfa98f; }
  .w-btns { display: flex; gap: 0.6em; margin-top: 0.4em; }
  .w-btn { font-style: normal; padding: 0.6em 1.1em; border-radius: 99px; background: #f0a35e; color: #2a1606; font-weight: 600; font-size: 0.85em; }
  .w-btn--ghost { background: transparent; color: #f0c48a; box-shadow: inset 0 0 0 1px rgba(240, 196, 138, 0.4); }
  .w-img {
    height: 100%;
    min-height: 8em;
    border-radius: 1em;
    background:
      radial-gradient(60% 50% at 70% 30%, rgba(255, 190, 120, 0.55), transparent 70%),
      radial-gradient(70% 70% at 30% 80%, #5a2e12, transparent 70%),
      linear-gradient(140deg, #3b1f0e, #8a4b1d);
  }
  .w-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.8em; padding: 0 1.5em 1.4em; }
  .w-card { display: flex; flex-direction: column; gap: 0.3em; padding: 0.6em; border-radius: 0.8em; background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.06); }
  .w-card i { height: 3.2em; border-radius: 0.55em; }
  .w-c1 { background: linear-gradient(135deg, #5b2c12, #c0612b); }
  .w-c2 { background: linear-gradient(135deg, #3a2a1a, #9b7a4f); }
  .w-c3 { background: linear-gradient(135deg, #2d3a14, #6f8f2a); }
  .w-card b { font-size: 0.8em; color: #f3e6d6; font-weight: 500; }
  .w-card em { font-style: normal; font-size: 0.75em; color: #f0a35e; }

  /* 02 · App (forma de teléfono) */
  .dv-app { display: flex; flex-direction: column; gap: 0.9em; padding: 3.2em 1.1em 1.1em; background: var(--bg); font-size: 1.05em; }
  .a-notch { position: absolute; top: 0.9em; left: 50%; width: 32%; height: 1.4em; border-radius: 99px; background: #000; transform: translateX(-50%); }
  .a-head { display: flex; justify-content: space-between; align-items: center; }
  .a-head b { font-size: 1.4em; letter-spacing: -0.02em; }
  .a-av { display: grid; place-items: center; width: 2.2em; height: 2.2em; border-radius: 50%; background: var(--accent); color: #fff; font-size: 0.75em; font-weight: 700; }
  .a-search { display: flex; align-items: center; gap: 0.5em; padding: 0.7em 0.9em; border-radius: 0.8em; background: var(--surface-2); color: var(--text-subtle); font-size: 0.85em; }
  .a-toast { display: flex; align-items: center; gap: 0.6em; padding: 0.7em 0.9em; border-radius: 0.8em; border: 1px solid rgba(var(--signal-rgb), 0.45); background: rgba(var(--signal-rgb), 0.1); color: var(--signal); font-size: 0.85em; font-weight: 600; }
  .a-toast i { width: 0.6em; height: 0.6em; border-radius: 50%; background: var(--signal); }
  .a-list { display: flex; flex-direction: column; gap: 0.6em; }
  .a-item { display: flex; flex-direction: column; gap: 0.35em; padding: 0.8em 0.9em; border-radius: 0.8em; background: var(--surface-1); border: 1px solid var(--border); }
  .a-item b { font-size: 0.85em; font-weight: 500; }
  .a-item em { font-style: normal; width: fit-content; padding: 0.15em 0.7em; border-radius: 99px; font-size: 0.75em; }
  .a-run { background: var(--accent-soft); color: var(--accent-text); }
  .a-ok { background: rgba(var(--signal-rgb), 0.12); color: var(--signal); }
  .a-wait { background: rgba(var(--warning-rgb), 0.12); color: var(--warning); }
  .a-tabs { margin-top: auto; display: flex; justify-content: space-around; padding-top: 0.9em; border-top: 1px solid var(--border); }
  .a-tabs i { width: 1.4em; height: 1.4em; border-radius: 0.45em; background: var(--surface-3); }
  .a-tabs i.is-on { background: var(--accent); }

  /* 03 · Chat con IA */
  .dv-chat { display: flex; flex-direction: column; background: #0d1512; font-size: 1.05em; }
  .c-head { display: flex; align-items: center; gap: 0.8em; padding: 1em 1.2em; border-bottom: 1px solid rgba(var(--signal-rgb), 0.18); }
  .c-head div { display: flex; flex-direction: column; line-height: 1.25; }
  .c-head b { font-size: 1em; }
  .c-head em { font-style: normal; font-size: 0.75em; color: var(--signal); }
  .c-av { display: grid; place-items: center; width: 2.4em; height: 2.4em; border-radius: 50%; background: linear-gradient(135deg, var(--accent), var(--signal)); color: #fff; }
  .c-body { flex: 1; display: flex; flex-direction: column; justify-content: flex-end; gap: 0.7em; padding: 1.2em; }
  .c-msg { max-width: 82%; padding: 0.7em 0.95em; border-radius: 1em 1em 1em 0.25em; background: #1c2a24; font-size: 0.9em; line-height: 1.4; }
  .c-msg--me { align-self: flex-end; border-radius: 1em 1em 0.25em 1em; background: var(--accent); color: #fff; }
  .c-card { display: flex; align-items: center; gap: 0.8em; max-width: 88%; padding: 0.7em; border-radius: 1em; background: #1c2a24; border: 1px solid rgba(var(--signal-rgb), 0.25); }
  .c-card i { flex: none; width: 3em; height: 3em; border-radius: 0.6em; background: linear-gradient(135deg, #5b2c12, #c0612b); }
  .c-card div { display: flex; flex-direction: column; flex: 1; min-width: 0; }
  .c-card b { font-size: 0.85em; font-weight: 500; }
  .c-card em { font-style: normal; font-size: 0.78em; color: var(--signal); }
  .c-card span { padding: 0.45em 0.9em; border-radius: 99px; background: var(--signal); color: #06140e; font-size: 0.75em; font-weight: 700; }

  /* 04 · Panel */
  .dv-panel { display: flex; background: var(--bg-elevated); }
  .p-side { display: flex; flex-direction: column; align-items: center; gap: 1em; width: 3.8em; padding: 1.2em 0; border-right: 1px solid var(--border); }
  .p-logo { width: 1.7em; height: 1.7em; border-radius: 0.5em; background: var(--accent); margin-bottom: 0.5em; }
  .p-side i { width: 1.5em; height: 1.5em; border-radius: 0.45em; background: var(--surface-3); }
  .p-side i.is-on { background: var(--accent-soft); box-shadow: inset 0 0 0 1px rgba(var(--accent-rgb), 0.6); }
  .p-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1em; padding: 1.2em 1.4em; }
  .p-head { display: flex; justify-content: space-between; align-items: center; }
  .p-head b { font-size: 1.2em; }
  .p-live { display: inline-flex; align-items: center; gap: 0.4em; font-size: 0.78em; color: var(--signal); }
  .p-live i { width: 0.55em; height: 0.55em; border-radius: 50%; background: var(--signal); }
  .p-kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.8em; }
  .p-kpis div { padding: 0.8em 0.9em; border-radius: 0.8em; border: 1px solid var(--border); background: var(--surface-1); }
  .p-kpis span { display: block; font-size: 0.75em; color: var(--text-subtle); }
  .p-kpis b { font-size: 1.35em; }
  .p-chart { flex: 1; display: flex; flex-direction: column; gap: 0.6em; padding: 0.9em 1em; border-radius: 0.8em; border: 1px solid var(--border); background: var(--surface-1); }
  .p-chart > span { font-size: 0.75em; color: var(--text-subtle); }
  .p-bars { flex: 1; display: flex; align-items: flex-end; gap: 0.7em; }
  .p-bars i { flex: 1; height: var(--h); border-radius: 0.35em 0.35em 0 0; background: linear-gradient(180deg, var(--accent-text), var(--accent)); transform-origin: bottom; }

  /* ---------- Etiquetas ---------- */
  .dv-tabs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
  }
  .dv-tab {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
    text-align: left;
    color: var(--text-subtle);
    transition: color var(--dur);
  }
  .dv-tab:hover { color: var(--text-muted); }
  .dv-tab.is-on { color: var(--text); }
  .dv-tab-n { font-size: 0.7rem; color: inherit; opacity: 0.7; }
  .dv-tab.is-on .dv-tab-n { color: var(--accent-text); opacity: 1; }
  .dv-tab-name { font-size: 0.88rem; line-height: 1.25; }
  .dv-tab-bar { width: 100%; height: 2px; margin-top: 0.35rem; border-radius: 2px; background: var(--border); overflow: hidden; }
  .dv-tab-bar i { display: block; height: 100%; background: var(--accent); transform: scaleX(0); transform-origin: left; }
  .dv-tab.is-on .dv-tab-bar i { transform: scaleX(1); }

  @media (max-width: 560px) {
    .dv-stage { aspect-ratio: 1 / 0.92; }
    .dv-device { font-size: clamp(8px, 2.3cqw, 12px); }
    .w-cards { display: none; }
    .dv-tabs { grid-template-columns: repeat(2, 1fr); row-gap: 1rem; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { reduceMotion, finePointer } from '../../scripts/env';

  // Forma del dispositivo en cada estado (porcentaje del escenario).
  const FORMAS = [
    { width: '96%', height: '74%', borderRadius: 16 }, // navegador
    { width: '40%', height: '98%', borderRadius: 34 }, // teléfono
    { width: '62%', height: '84%', borderRadius: 24 }, // chat
    { width: '96%', height: '78%', borderRadius: 16 }, // panel
  ];
  const FORMAS_MOVIL = [
    { width: '98%', height: '76%', borderRadius: 14 },
    { width: '50%', height: '98%', borderRadius: 30 },
    { width: '80%', height: '88%', borderRadius: 22 },
    { width: '98%', height: '80%', borderRadius: 14 },
  ];
  const HOLD = 3.6; // segundos en cada estado

  document.querySelectorAll<HTMLElement>('[data-dv]').forEach((root) => {
    const stage = root.querySelector<HTMLElement>('[data-dv-stage]')!;
    const device = root.querySelector<HTMLElement>('[data-dv-device]')!;
    const screens = Array.from(root.querySelectorAll<HTMLElement>('[data-dv-screen]'));
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dv-tab]'));
    const bars = tabs.map((t) => t.querySelector<HTMLElement>('[data-dv-progress]')!);
    const formas = () => (window.matchMedia('(max-width: 560px)').matches ? FORMAS_MOVIL : FORMAS);

    let current = 0;
    let visible = false;
    let progress: gsap.core.Tween | null = null;
    let morph: gsap.core.Timeline | null = null;

    const setTabs = (i: number) =>
      tabs.forEach((t, j) => {
        t.classList.toggle('is-on', j === i);
        t.setAttribute('aria-pressed', String(j === i));
      });

    // Pequeña animación propia de cada pantalla mientras está a la vista.
    const micro = (i: number) => {
      const s = screens[i];
      const items = s.querySelectorAll('[data-dv-anim]');
      const tl = gsap.timeline();
      tl.fromTo(items, { autoAlpha: 0, y: 10 }, { autoAlpha: 1, y: 0, duration: 0.5, stagger: i === 2 ? 0.55 : 0.12, ease: 'power3.out' });
      if (i === 3) tl.fromTo(s.querySelectorAll('[data-dv-bar]'), { scaleY: 0 }, { scaleY: 1, duration: 0.8, stagger: 0.06, ease: 'power3.out' }, 0.2);
      return tl;
    };

    const startProgress = () => {
      progress?.kill();
      bars.forEach((b, j) => gsap.set(b, { scaleX: j === current ? 0 : j < current ? 1 : 0 }));
      progress = gsap.to(bars[current], {
        scaleX: 1,
        duration: HOLD,
        ease: 'none',
        paused: !visible || document.hidden,
        onComplete: () => goTo((current + 1) % screens.length),
      });
    };

    function goTo(next: number) {
      if (next === current && morph) return;
      const prev = screens[current];
      const target = screens[next];
      const forma = formas()[next];
      current = next;
      setTabs(next);
      morph?.kill();
      // El temporizador del estado anterior no debe seguir corriendo (si no, salta antes de tiempo).
      progress?.kill();
      progress = null;
      bars.forEach((b, j) => gsap.set(b, { scaleX: j < next ? 1 : 0 }));

      if (reduceMotion) {
        screens.forEach((s) => s.classList.toggle('is-active', s === target));
        gsap.set(device, forma);
        return;
      }

      morph = gsap
        .timeline()
        .to(prev, { autoAlpha: 0, scale: 0.97, duration: 0.25, ease: 'power2.in' })
        .call(() => {
          prev.classList.remove('is-active');
          target.classList.add('is-active');
        })
        .to(device, { ...forma, duration: 0.9, ease: 'expo.inOut' })
        .fromTo(target, { autoAlpha: 0, scale: 1.03 }, { autoAlpha: 1, scale: 1, duration: 0.45, ease: 'power2.out' }, '-=0.25')
        .add(() => {
          micro(next);
          startProgress();
        }, '-=0.2');
    }

    tabs.forEach((tab, i) =>
      tab.addEventListener('click', () => {
        if (i !== current) goTo(i);
      })
    );

    if (reduceMotion) return;

    // Solo avanza mientras se ve; al volver a la vista, retoma donde iba.
    const sync = () => {
      const run = visible && !document.hidden;
      if (progress) run ? progress.play() : progress.pause();
    };
    let started = false;
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible && !started) {
        started = true;
        micro(current);
        startProgress();
      }
      sync();
    }, { threshold: 0.3 }).observe(stage);
    document.addEventListener('visibilitychange', sync);

    // Inclinación sutil con el cursor.
    if (finePointer) {
      const rx = gsap.quickTo(device, 'rotationX', { duration: 0.8, ease: 'power3.out' });
      const ry = gsap.quickTo(device, 'rotationY', { duration: 0.8, ease: 'power3.out' });
      stage.addEventListener('pointermove', (e) => {
        const r = stage.getBoundingClientRect();
        ry(((e.clientX - r.left) / r.width - 0.5) * 7);
        rx(-((e.clientY - r.top) / r.height - 0.5) * 6);
      });
      stage.addEventListener('pointerleave', () => {
        rx(0);
        ry(0);
      });
    }

    // Al cambiar a/desde móvil, la forma actual se ajusta sin animación.
    window.matchMedia('(max-width: 560px)').addEventListener('change', () => gsap.set(device, formas()[current]));
    // El centrado pasa a porcentajes de GSAP para que se mantenga mientras cambia el tamaño.
    gsap.set(device, { x: 0, y: 0, xPercent: -50, yPercent: -50, ...formas()[0] });

    if (import.meta.env.DEV) (window as any).__device = { goTo, get current() { return current; } };
  });
</script>
