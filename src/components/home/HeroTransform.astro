---
// src/components/home/HeroTransform.astro
// "De la idea a la operación": el visitante elige qué lo frena hoy y ve su problema convertirse en un sistema
// a través de las 4 fases del método (Idea → Arquitectura → Construcción → Operación).
// Estados visuales por clases en la raíz (is-arq, is-build, is-live); el JS solo las va encendiendo.
// Sin JS o con reduced-motion se muestra el estado final ("en operación") del primer escenario.
import Icon, { type IconName } from '../ui/Icon.astro';

interface Modulo {
  icon: IconName;
  titulo: string;
  valor: string;
}
interface Escenario {
  chip: string;
  dolores: string[];
  modulos: Modulo[];
}

const escenarios: Escenario[] = [
  {
    chip: 'Inventario en Excel',
    dolores: ['Stock en hojas de cálculo', 'Conteos a mano cada semana', 'Pedidos que no cuadran'],
    modulos: [
      { icon: 'database', titulo: 'Inventario en tiempo real', valor: 'actualizado' },
      { icon: 'sparkles', titulo: 'Alertas de reposición', valor: 'automáticas' },
      { icon: 'layout', titulo: 'Tablero de gerencia', valor: 'en vivo' },
    ],
  },
  {
    chip: 'Aprobaciones por WhatsApp',
    dolores: ['Solicitudes perdidas en chats', 'Nadie sabe quién aprobó', 'Respuestas que tardan días'],
    modulos: [
      { icon: 'workflow', titulo: 'Flujo de aprobaciones', valor: 'en minutos' },
      { icon: 'whatsapp', titulo: 'Asistente con IA', valor: '24/7' },
      { icon: 'shield', titulo: 'Historial auditable', valor: 'cada paso' },
    ],
  },
  {
    chip: 'Trazabilidad en papel',
    dolores: ['Registros en planillas', 'Lotes sin rastro', 'Reportes días después'],
    modulos: [
      { icon: 'route', titulo: 'Trazabilidad por lote', valor: 'de punta a punta' },
      { icon: 'layers', titulo: 'Etiquetas automáticas', valor: 'al instante' },
      { icon: 'layout', titulo: 'Reportes en vivo', valor: 'sin esperar' },
    ],
  },
];

const fases = [
  { nombre: 'Idea', texto: 'Entendemos lo que hoy te frena.' },
  { nombre: 'Arquitectura', texto: 'Diseñamos cómo se conecta todo.' },
  { nombre: 'Construcción', texto: 'Lo construimos por módulos.' },
  { nombre: 'Operación', texto: 'Tu equipo lo usa todos los días.' },
];

// Geometría en el viewBox 160×100 (misma proporción que el escenario, 16:10).
const filas = [18, 50, 82];
const wiresIn = filas.map((y) => `M50 ${y} C 62 ${y}, 60 50, 71 50`);
const wiresOut = filas.map((y) => `M89 50 C 100 50, 98 ${y}, 110 ${y}`);
---

<div class="ht is-arq is-build is-live" data-ht data-scenario="0">
  <div class="ht-glow" aria-hidden="true"></div>
  <div class="ht-card">
    <header class="ht-head">
      <span class="ht-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="ht-title mono">de-la-idea-a-la-operacion</span>
      <span class="ht-status mono"><i></i><span data-ht-status>en operación</span></span>
    </header>

    <div class="ht-ask">
      <p class="ht-ask-label">¿Qué te frena hoy?</p>
      <div class="ht-chips" role="group" aria-label="Elige un problema para ver cómo lo resolvemos">
        {escenarios.map((e, i) => (
          <button type="button" class:list={['ht-chip', { 'is-on': i === 0 }]} data-ht-chip={i} aria-pressed={i === 0 ? 'true' : 'false'}>
            {e.chip}
          </button>
        ))}
      </div>
    </div>

    <div class="ht-labels mono" aria-hidden="true">
      <span>Hoy</span>
      <span>Tu sistema</span>
    </div>

    <div class="ht-stage">
      <svg class="ht-wires" viewBox="0 0 160 100" aria-hidden="true">
        {[...wiresIn, ...wiresOut].map((d, i) => <path id={`ht-w-${i}`} d={d} pathLength="1" class:list={['ht-wire', { 'ht-wire--out': i > 2 }]} />)}
        <g class="ht-packets">
          {[...wiresIn, ...wiresOut].map((_, i) => (
            <circle r="1.3" class:list={['ht-packet', { 'ht-packet--out': i > 2 }]}>
              <animateMotion dur={i > 2 ? '1.6s' : '1.9s'} repeatCount="indefinite" begin={`-${(i % 3) * 0.55 + (i > 2 ? 0.3 : 0)}s`}>
                <mpath href={`#ht-w-${i}`} />
              </animateMotion>
            </circle>
          ))}
        </g>
      </svg>

      {filas.map((y, i) => (
        <div class="ht-pain" style={`--y:${y}%; --i:${i}; --r:${[-1.4, 1, -0.6][i]}deg`}>
          {escenarios.map((e, s) => (
            <span class="ht-variant" data-s={s}>{e.dolores[i]}</span>
          ))}
        </div>
      ))}

      <div class="ht-core" aria-hidden="true">
        <span class="ht-core-ring"></span>
        <svg viewBox="0 0 64 64" fill="none">
          <path d="M17 20h30" stroke="currentColor" stroke-width="5" stroke-linecap="round" />
          <path d="M32 20v24" stroke="currentColor" stroke-width="5" stroke-linecap="round" />
          <circle cx="32" cy="46" r="5" fill="var(--accent)" />
        </svg>
      </div>

      {filas.map((y, i) => (
        <div class="ht-mod" style={`--y:${y}%; --i:${i}`}>
          <span class="ht-skel" aria-hidden="true"><i></i><i></i></span>
          {escenarios.map((e, s) => (
            <span class="ht-variant ht-mod-body" data-s={s}>
              <span class="ht-mod-icon"><Icon name={e.modulos[i].icon} size={14} /></span>
              <span class="ht-mod-text">
                <b>{e.modulos[i].titulo}</b>
                <span class="ht-mod-val"><i></i>{e.modulos[i].valor}</span>
              </span>
            </span>
          ))}
        </div>
      ))}
    </div>

    <footer class="ht-phases">
      <ol class="ht-steps" role="list">
        {fases.map((f, i) => (
          <li class="ht-step is-done" data-ht-step={i}>
            <span class="ht-bar"><i></i></span>
            <span class="mono ht-step-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="ht-step-name">{f.nombre}</span>
          </li>
        ))}
      </ol>
      <p class="ht-caption" data-ht-caption aria-live="polite">{fases[3].texto}</p>
    </footer>
  </div>
</div>
<script is:inline>
  // Antes del primer pintado: si habrá animación, el componente arranca en la fase "idea" (sin parpadeo).
  (function () {
    var el = document.currentScript && document.currentScript.previousElementSibling;
    var quiet = matchMedia('(prefers-reduced-motion: reduce)').matches || /[?&]sinmovimiento/.test(location.search);
    if (el && !quiet) {
      el.classList.remove('is-arq', 'is-build', 'is-live');
      el.classList.add('is-reset');
    }
  })();
</script>

<style>
  .ht {
    position: relative;
    container-type: inline-size;
    width: 100%;
    font-size: clamp(10px, 2cqw, 14px);
  }
  .ht-glow {
    position: absolute;
    inset: 10% 0 0 10%;
    background: radial-gradient(closest-side, rgba(var(--accent-rgb), 0.28), transparent 75%);
    filter: blur(30px);
    pointer-events: none;
  }
  .ht-card {
    position: relative;
    border-radius: 1.3em;
    background: linear-gradient(180deg, var(--surface-2), var(--surface-1) 40%);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  /* ---------- Cabecera ---------- */
  .ht-head {
    display: flex;
    align-items: center;
    gap: 1em;
    padding: 0.85em 1.2em;
    border-bottom: 1px solid var(--border);
  }
  .ht-dots { display: flex; gap: 0.45em; }
  .ht-dots i { width: 0.65em; height: 0.65em; border-radius: 50%; background: var(--border-strong); }
  .ht-title { font-size: 0.78em; color: var(--text-subtle); }
  .ht-status {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.25em 0.75em;
    border: 1px solid var(--border);
    border-radius: 99px;
    font-size: 0.75em;
    color: var(--text-muted);
    transition: color 0.4s, border-color 0.4s;
  }
  .ht-status i {
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    background: var(--warning);
    transition: background 0.4s;
  }
  .ht.is-live .ht-status { color: var(--signal); border-color: rgba(var(--signal-rgb), 0.4); }
  .ht.is-live .ht-status i { background: var(--signal); box-shadow: 0 0 0 0.25em rgba(var(--signal-rgb), 0.18); }

  /* ---------- Pregunta y chips ---------- */
  .ht-ask {
    display: flex;
    flex-direction: column;
    gap: 0.6em;
    padding: 1.1em 1.2em 0.4em;
  }
  .ht-ask-label { font-size: 0.95em; font-weight: 500; }
  .ht-chips { display: flex; flex-wrap: wrap; gap: 0.45em; }
  .ht-chip {
    padding: 0.45em 0.9em;
    border: 1px solid var(--border-strong);
    border-radius: 99px;
    font-size: 0.82em;
    color: var(--text-muted);
    transition: background var(--dur-fast), border-color var(--dur-fast), color var(--dur-fast);
  }
  .ht-chip:hover { border-color: var(--text-muted); color: var(--text); }
  .ht-chip.is-on { background: var(--accent); border-color: var(--accent); color: #fff; }

  .ht-labels {
    display: flex;
    justify-content: space-between;
    padding: 0.9em 1.2em 0;
    font-size: 0.68em;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }

  /* ---------- Escenario (16:10, misma proporción que el viewBox) ---------- */
  .ht-stage {
    position: relative;
    aspect-ratio: 16 / 10;
    margin: 0.4em 1.2em 0;
  }
  .ht-wires { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .ht-wire {
    fill: none;
    stroke: var(--border-strong);
    stroke-width: 0.45;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .ht-wire--out { stroke: rgba(var(--accent-rgb), 0.6); }
  .ht.is-arq .ht-wire {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.1s var(--ease-out) calc(var(--i, 0) * 80ms);
  }
  .ht-packet { fill: var(--warning); opacity: 0; transition: opacity 0.4s; }
  .ht-packet--out { fill: var(--signal); }
  .ht.is-live .ht-packet { opacity: 1; }

  /* Dolores (columna "Hoy") */
  .ht-pain {
    position: absolute;
    left: 0;
    top: var(--y);
    width: 31.25%;
    transform: translateY(-50%);
    padding: 0.6em 0.75em;
    border: 1px dashed rgba(var(--warning-rgb), 0.45);
    border-radius: 0.6em;
    background: rgba(var(--warning-rgb), 0.06);
    font-size: 0.8em;
    line-height: 1.3;
    color: var(--text);
    transition: opacity 0.45s var(--ease-out), transform 0.45s var(--ease-out), color 0.45s;
    transition-delay: calc(var(--i) * 90ms);
  }
  .ht-pain { rotate: var(--r); }
  .ht.is-reset .ht-pain { opacity: 0; transform: translateY(-50%) scale(0.92); transition: none; }
  .ht.is-live .ht-pain { color: var(--text-muted); border-color: rgba(var(--warning-rgb), 0.25); background: transparent; }
  .ht.is-live .ht-pain .ht-variant {
    text-decoration: line-through;
    text-decoration-color: rgba(var(--warning-rgb), 0.55);
    text-decoration-thickness: 1px;
  }

  /* Núcleo Transformia */
  .ht-core {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 11.25%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    border-radius: 22%;
    border: 1px solid var(--border-strong);
    background: var(--surface-2);
    color: var(--text);
    opacity: 0.55;
    transition: opacity 0.5s, box-shadow 0.5s, border-color 0.5s;
  }
  .ht-core svg { width: 62%; height: 62%; }
  .ht-core-ring {
    position: absolute;
    inset: -28%;
    border-radius: 50%;
    border: 1px dashed rgba(var(--accent-rgb), 0.55);
    opacity: 0;
    transition: opacity 0.5s;
  }
  .ht.is-arq .ht-core { opacity: 1; border-color: rgba(var(--accent-rgb), 0.6); }
  .ht.is-build .ht-core-ring { opacity: 1; animation: ht-spin 6s linear infinite; }
  .ht.is-live .ht-core { box-shadow: 0 0 0 0.35em rgba(var(--accent-rgb), 0.12), 0 0 2.5em rgba(var(--accent-rgb), 0.45); }
  @keyframes ht-spin { to { rotate: 360deg; } }

  /* Módulos (columna "Tu sistema") */
  .ht-mod {
    position: absolute;
    left: 68.75%;
    top: var(--y);
    width: 31.25%;
    min-height: 3.6em;
    transform: translateY(-50%);
    display: grid;
    align-items: center;
    padding: 0.55em 0.7em;
    border: 1px dashed var(--border-strong);
    border-radius: 0.7em;
    background: transparent;
    transition: border-color 0.5s, background 0.5s, box-shadow 0.5s;
    transition-delay: calc(var(--i) * 120ms);
  }
  .ht-skel { display: flex; flex-direction: column; gap: 0.45em; grid-area: 1 / 1; transition: opacity 0.35s; }
  .ht-skel i { height: 0.5em; border-radius: 0.3em; background: var(--surface-3); }
  .ht-skel i:last-child { width: 60%; }
  .ht-mod-body { grid-area: 1 / 1; opacity: 0; transform: translateY(0.4em); transition: opacity 0.45s, transform 0.45s; transition-delay: calc(var(--i) * 120ms + 150ms); }
  .ht.is-arq .ht-mod { border-style: solid; border-color: rgba(var(--accent-rgb), 0.45); }
  .ht.is-build .ht-mod { background: var(--surface-2); border-color: rgba(var(--accent-rgb), 0.6); }
  .ht.is-build .ht-skel { opacity: 0; }
  .ht.is-build .ht-mod-body { opacity: 1; transform: none; }
  .ht.is-live .ht-mod { border-color: rgba(var(--signal-rgb), 0.45); box-shadow: 0 0.6em 1.6em -0.8em rgba(var(--signal-rgb), 0.5); }

  .ht-mod-body { display: flex; align-items: center; gap: 0.55em; }
  .ht-mod-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 2em;
    height: 2em;
    border-radius: 0.55em;
    background: var(--accent-soft);
    color: var(--accent-text);
  }
  .ht-mod-icon :global(svg) { width: 1.1em; height: 1.1em; }
  .ht-mod-text { display: flex; flex-direction: column; min-width: 0; line-height: 1.25; }
  .ht-mod-text b { font-size: 0.8em; font-weight: 600; }
  .ht-mod-val {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-family: var(--font-mono);
    font-size: 0.68em;
    color: var(--text-subtle);
    opacity: 0;
    transition: opacity 0.4s, color 0.4s;
  }
  .ht-mod-val i { width: 0.5em; height: 0.5em; border-radius: 50%; background: var(--signal); }
  .ht.is-live .ht-mod-val { opacity: 1; color: var(--signal); }

  /* Variantes por escenario */
  .ht[data-scenario='0'] .ht-variant:not([data-s='0']),
  .ht[data-scenario='1'] .ht-variant:not([data-s='1']),
  .ht[data-scenario='2'] .ht-variant:not([data-s='2']) {
    display: none;
  }

  /* ---------- Fases ---------- */
  .ht-phases {
    padding: 1.1em 1.2em 1.2em;
    margin-top: 0.6em;
    border-top: 1px solid var(--border);
  }
  .ht-steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.6em; }
  .ht-step { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.15em 0.45em; }
  .ht-bar { flex-basis: 100%; height: 0.22em; border-radius: 1em; background: var(--surface-3); overflow: hidden; margin-bottom: 0.45em; }
  .ht-bar i { display: block; height: 100%; background: var(--accent); transform: scaleX(0); transform-origin: left; }
  .ht-step-num { font-size: 0.65em; color: var(--text-subtle); }
  .ht-step-name { font-size: 0.78em; color: var(--text-subtle); transition: color 0.3s; }
  .ht-step.is-done .ht-bar i { transform: scaleX(1); }
  .ht-step.is-done .ht-step-name,
  .ht-step.is-active .ht-step-name { color: var(--text); }
  .ht-step.is-active .ht-bar i { animation: ht-fill var(--phase-ms, 1700ms) linear forwards; }
  .ht.is-live .ht-step:last-child .ht-bar i { background: var(--signal); }
  @keyframes ht-fill { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  .ht-caption { margin-top: 0.75em; font-size: 0.85em; color: var(--text-muted); min-height: 1.4em; }

  /* Transición entre escenarios */
  .ht-stage, .ht-labels { transition: opacity 0.3s var(--ease-out); }
  .ht.is-out .ht-stage { opacity: 0; }

  @media (prefers-reduced-motion: reduce) {
    .ht-packets { display: none; }
  }
</style>

<script>
  import { reduceMotion } from '../../scripts/env';

  const root = document.querySelector<HTMLElement>('[data-ht]');

  if (root) {
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-ht-chip]'));
    const steps = Array.from(root.querySelectorAll<HTMLElement>('[data-ht-step]'));
    const status = root.querySelector<HTMLElement>('[data-ht-status]');
    const caption = root.querySelector<HTMLElement>('[data-ht-caption]');
    const svg = root.querySelector<SVGSVGElement>('.ht-wires');
    const captions = [
      'Entendemos lo que hoy te frena.',
      'Diseñamos cómo se conecta todo.',
      'Lo construimos por módulos.',
      'Tu equipo lo usa todos los días.',
    ];
    const statuses = ['idea', 'arquitectura', 'construyendo', 'en operación'];
    const PHASE_MS = [1700, 1700, 1700, 3800];
    const total = chips.length;

    let scenario = 0;
    let phase = 3;
    let timer = 0;
    let visible = true;

    const setScenario = (s: number) => {
      scenario = s;
      root.dataset.scenario = String(s);
      chips.forEach((c, i) => {
        c.classList.toggle('is-on', i === s);
        c.setAttribute('aria-pressed', String(i === s));
      });
    };

    const setPhase = (p: number) => {
      phase = p;
      root.classList.toggle('is-arq', p >= 1);
      root.classList.toggle('is-build', p >= 2);
      root.classList.toggle('is-live', p >= 3);
      steps.forEach((st, i) => {
        st.classList.toggle('is-done', i < p);
        st.classList.remove('is-active');
      });
      const active = steps[p];
      if (active) {
        void active.offsetWidth; // reinicia la animación de la barra
        active.style.setProperty('--phase-ms', `${PHASE_MS[p]}ms`);
        active.classList.add('is-active');
      }
      if (status) status.textContent = statuses[p];
      if (caption) caption.textContent = captions[p];
    };

    const schedule = (fn: () => void, ms: number) => {
      window.clearTimeout(timer);
      timer = window.setTimeout(fn, ms);
    };

    const startCycle = (s: number) => {
      root.classList.add('is-out');
      schedule(() => {
        setScenario(s);
        root.classList.add('is-reset');
        setPhase(0);
        void root.offsetWidth;
        root.classList.remove('is-reset', 'is-out');
        schedule(advance, PHASE_MS[0]);
      }, 300);
    };

    function advance() {
      if (!visible || document.hidden) {
        schedule(advance, 400); // en pausa mientras no se ve
        return;
      }
      if (phase < 3) {
        setPhase(phase + 1);
        schedule(advance, PHASE_MS[phase]);
      } else {
        startCycle((scenario + 1) % total);
      }
    }

    chips.forEach((chip, i) =>
      chip.addEventListener('click', () => {
        if (reduceMotion) {
          setScenario(i);
          return;
        }
        startCycle(i);
      })
    );

    if (!reduceMotion) {
      new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        if (svg) visible ? svg.unpauseAnimations() : svg.pauseAnimations();
      }).observe(root);

      root.classList.remove('is-reset');
      setPhase(0);
      schedule(advance, PHASE_MS[0] + 400);
    }
  }
</script>
