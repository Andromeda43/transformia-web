---
// src/components/home/HomeHero.astro — titular, una frase, dos botones y el dispositivo que se transforma.
import HeroDevice from './HeroDevice.astro';
import Button from '../ui/Button.astro';
import { whatsappLink } from '../../data/site';
---

<section class="hero">
  <div class="blueprint"></div>
  <div class="hero-aura" aria-hidden="true"></div>

  <div class="container hero-grid">
    <div class="hero-copy">
      <h1 class="display hero-title" data-split>
        Construimos el software que <span class="gradient-text">tu operación</span> necesita.
      </h1>

      <p class="lead" data-reveal data-reveal-delay="0.15">
        Páginas web, apps móviles, inteligencia artificial y sistemas de gestión, diseñados a la medida de tu empresa.
      </p>

      <div class="hero-actions" data-reveal data-reveal-delay="0.25">
        <Button href="/contacto" icon="arrow" magnetic>Agenda un diagnóstico</Button>
        <Button href={whatsappLink()} variant="secondary" iconStart="whatsapp" external>Escríbenos por WhatsApp</Button>
      </div>
    </div>

    <div class="hero-visual" data-reveal data-reveal-delay="0.1">
      <HeroDevice />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: calc(var(--nav-height) + 3rem) 0 4rem;
    overflow: hidden;
  }
  .hero-aura {
    position: absolute;
    top: -20%;
    right: -10%;
    width: 70vw;
    height: 70vw;
    max-width: 1000px;
    max-height: 1000px;
    background: radial-gradient(closest-side, rgba(var(--accent-rgb), 0.14), transparent 70%);
    pointer-events: none;
  }
  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(2.5rem, 2rem + 3vw, 5rem);
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }
  .hero-title {
    font-size: clamp(2.6rem, 1.3rem + 3.8vw, 4.6rem);
  }
  .hero-copy .lead {
    max-width: 44ch;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  @media (max-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-visual {
      max-width: 640px;
      width: 100%;
      margin-inline: auto;
    }
  }
  @media (max-width: 520px) {
    .hero-actions :global(.btn) {
      width: 100%;
    }
  }
</style>
