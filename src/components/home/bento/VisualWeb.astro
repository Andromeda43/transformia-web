---
// Sitios web: un sitio se arma en el navegador y sus indicadores de calidad se completan.
import Icon from '../../ui/Icon.astro';
const metricas = ['Rendimiento', 'Accesibilidad', 'SEO'];
---

<div class="vw">
  <div class="vw-site">
    <div class="vw-bar"><i></i><i></i><i></i><span class="mono">tuempresa.co</span></div>
    <div class="vw-body">
      <div class="vw-nav"><span class="vw-logo"></span><span></span><span></span><span></span></div>
      <span class="vw-h vw-h--1"></span>
      <span class="vw-h vw-h--2"></span>
      <span class="vw-p"></span>
      <span class="vw-btn"></span>
      <span class="vw-img"></span>
    </div>
  </div>
  <ul class="vw-scores" role="list">
    {metricas.map((m, i) => (
      <li style={`--i:${i}`}>
        <svg viewBox="0 0 40 40" class="vw-ring">
          <circle cx="20" cy="20" r="16" pathLength="100" class="vw-ring-bg" />
          <circle cx="20" cy="20" r="16" pathLength="100" class="vw-ring-fg" />
        </svg>
        <span class="vw-check"><Icon name="check" size={12} strokeWidth={2.8} /></span>
        <span class="vw-label">{m}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .vw { display: grid; grid-template-columns: 1.35fr 1fr; gap: 14px; align-items: center; width: 100%; max-width: 420px; }
  .vw-site { border: 1px solid var(--border-strong); border-radius: 10px; background: var(--bg-elevated); overflow: hidden; }
  .vw-bar { display: flex; align-items: center; gap: 4px; padding: 6px 8px; border-bottom: 1px solid var(--border); }
  .vw-bar i { width: 6px; height: 6px; border-radius: 50%; background: var(--border-strong); }
  .vw-bar span { margin-left: 8px; font-size: 8px; color: var(--text-subtle); }
  .vw-body { display: flex; flex-direction: column; gap: 6px; padding: 9px; }
  .vw-nav { display: flex; gap: 6px; align-items: center; margin-bottom: 4px; }
  .vw-nav span { width: 18px; height: 4px; border-radius: 2px; background: var(--surface-3); }
  .vw-nav .vw-logo { width: 12px; height: 12px; border-radius: 4px; background: var(--accent); margin-right: auto; }
  .vw-h { height: 8px; border-radius: 3px; background: var(--text); opacity: 0.85; }
  .vw-h--1 { width: 85%; }
  .vw-h--2 { width: 60%; }
  .vw-p { width: 75%; height: 5px; border-radius: 3px; background: var(--surface-3); }
  .vw-btn { width: 38%; height: 12px; border-radius: 99px; background: var(--accent); margin-top: 2px; }
  .vw-img { height: 34px; border-radius: 6px; background: linear-gradient(135deg, #2a1f45, rgba(var(--accent-rgb), 0.6)); margin-top: 2px; }

  .vw-scores { display: flex; flex-direction: column; gap: 9px; }
  .vw-scores li { position: relative; display: flex; align-items: center; gap: 8px; }
  .vw-ring { width: 32px; height: 32px; rotate: -90deg; flex: none; }
  .vw-ring circle { fill: none; stroke-width: 4; }
  .vw-ring-bg { stroke: var(--surface-3); }
  .vw-ring-fg { stroke: var(--signal); stroke-linecap: round; stroke-dasharray: 100; stroke-dashoffset: 0; }
  .vw-check { position: absolute; left: 0; top: 0; width: 32px; height: 32px; display: grid; place-items: center; color: var(--signal); }
  .vw-label { font-size: 10px; color: var(--text-muted); }

  :global(.is-playing) .vw-body > * { animation: vw-build 6s var(--ease-out) infinite; }
  :global(.is-playing) .vw-body > :nth-child(2) { animation-delay: 0.15s; }
  :global(.is-playing) .vw-body > :nth-child(3) { animation-delay: 0.25s; }
  :global(.is-playing) .vw-body > :nth-child(4) { animation-delay: 0.35s; }
  :global(.is-playing) .vw-body > :nth-child(5) { animation-delay: 0.45s; }
  :global(.is-playing) .vw-body > :nth-child(6) { animation-delay: 0.55s; }
  :global(.is-playing) .vw-ring-fg { animation: vw-ring 6s var(--ease-out) infinite; animation-delay: calc(var(--i) * 0.2s); }
  :global(.is-playing) .vw-check { animation: vw-check 6s var(--ease-out) infinite; animation-delay: calc(var(--i) * 0.2s); }
  @keyframes vw-build {
    0% { opacity: 0; transform: translateY(5px); }
    10%, 90% { opacity: 1; transform: none; }
    100% { opacity: 0; }
  }
  @keyframes vw-ring {
    0%, 18% { stroke-dashoffset: 100; }
    48%, 92% { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: 0; opacity: 0; }
  }
  @keyframes vw-check {
    0%, 46% { opacity: 0; transform: scale(0.4); }
    52% { opacity: 1; transform: scale(1.15); }
    56%, 92% { opacity: 1; transform: scale(1); }
    100% { opacity: 0; }
  }
</style>
