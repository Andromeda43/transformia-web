---
// src/components/servicios/ServiceWhat.astro — "¿Qué es?": definición en lenguaje simple + analogía.
interface Props {
  pregunta: string;
  titulo: string;
  texto: string;
  analogia: string;
}
const { pregunta, titulo, texto, analogia } = Astro.props;
const words = texto.split(' ');
---

<section class="section what">
  <div class="container what-grid">
    <header class="what-head">
      <p class="eyebrow" data-reveal>{pregunta}</p>
      <h2 class="h2" data-split>{titulo}</h2>
    </header>
    <div class="what-body">
      <p class="what-text" data-what-text>
        {words.map((w) => <span>{w} </span>)}
      </p>
      <figure class="what-analogy spot" data-spotlight data-reveal>
        <span class="what-mark" aria-hidden="true">≈</span>
        <figcaption class="mono">En pocas palabras</figcaption>
        <blockquote>{analogia}</blockquote>
      </figure>
    </div>
  </div>
</section>

<style>
  .what-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }
  .what-head {
    position: sticky;
    top: calc(var(--nav-height) + 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .what-body {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .what-text {
    font-size: clamp(1.3rem, 1.05rem + 1vw, 1.85rem);
    line-height: 1.45;
    font-weight: 500;
    letter-spacing: -0.015em;
  }
  .what-analogy {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.75rem 1.75rem 1.75rem 4.75rem;
  }
  .what-mark {
    position: absolute;
    left: 1.5rem;
    top: 1.35rem;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 12px;
    background: var(--accent-soft);
    color: var(--accent-text);
    font-size: 1.5rem;
    line-height: 1;
  }
  .what-analogy figcaption {
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-subtle);
  }
  .what-analogy blockquote {
    font-size: 1.15rem;
    line-height: 1.55;
    color: var(--text);
  }
  @media (max-width: 900px) {
    .what-grid {
      grid-template-columns: 1fr;
    }
    .what-head {
      position: static;
    }
    .what-analogy {
      padding: 1.5rem;
      padding-top: 4.25rem;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { reduceMotion } from '../../scripts/env';

  gsap.registerPlugin(ScrollTrigger);
  // Las palabras se iluminan a medida que se lee (scroll).
  if (!reduceMotion) {
    document.querySelectorAll<HTMLElement>('[data-what-text]').forEach((el) => {
      gsap.fromTo(
        el.children,
        { opacity: 0.18 },
        { opacity: 1, ease: 'none', stagger: 0.1, scrollTrigger: { trigger: el, start: 'top 82%', end: 'bottom 50%', scrub: true } }
      );
    });
  }
</script>
