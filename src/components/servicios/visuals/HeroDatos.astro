---
// Bases de datos: de un Excel con duplicados a una tabla limpia que responde preguntas.
import VisualFrame from '../VisualFrame.astro';
import Icon from '../../ui/Icon.astro';

const sucio = [
  { n: 'juan perez', c: 'yopal', dup: true },
  { n: 'Juan Pérez', c: 'Yopal', dup: true },
  { n: 'JUAN P.', c: 'YOPAL', dup: true },
  { n: 'María Gómez', c: 'Aguazul', dup: true },
  { n: 'maria gomez ', c: 'aguazul', dup: true },
  { n: 'Carlos Ruiz', c: 'Monterrey', dup: false },
];
const limpio = [
  { id: 1, n: 'Juan Pérez', c: 'Yopal' },
  { id: 2, n: 'María Gómez', c: 'Aguazul' },
  { id: 3, n: 'Carlos Ruiz', c: 'Monterrey' },
];
const barras = [
  { n: 'Juan', v: 82 },
  { n: 'María', v: 64 },
  { n: 'Carlos', v: 46 },
];
---

<VisualFrame label="clientes.xlsx → base-de-datos" status="sin duplicados">
  <div class="hd" data-hd>
    <div class="hd-top">
      <div class="hd-sheet" data-hd-sheet>
        <div class="hd-sheet-head mono"><span>A · nombre</span><span>B · ciudad</span></div>
        {sucio.map((r) => (
          <div class:list={['hd-row', { 'is-dup': r.dup }]} data-hd-dirty>
            <span>{r.n}</span><span>{r.c}</span>
          </div>
        ))}
      </div>

      <span class="hd-arrow" data-hd-arrow><Icon name="arrow" size={18} /></span>

      <div class="hd-table">
        <div class="hd-table-head"><Icon name="database" size={13} /> <b class="mono">clientes</b></div>
        {limpio.map((r) => (
          <div class="hd-trow" data-hd-clean>
            <span class="mono">{r.id}</span><span>{r.n}</span><span>{r.c}</span>
          </div>
        ))}
        <span class="hd-badge mono" data-hd-badge><Icon name="check" size={11} strokeWidth={2.6} /> 3 duplicados unidos</span>
      </div>
    </div>

    <div class="hd-query">
      <div class="hd-q mono"><span class="hd-prompt">›</span><span data-hd-q>ventas por cliente este mes</span></div>
      <div class="hd-bars">
        {barras.map((b) => (
          <div class="hd-bar">
            <span>{b.n}</span>
            <i><em style={`--v:${b.v}%`} data-hd-bar></em></i>
          </div>
        ))}
      </div>
    </div>
  </div>
</VisualFrame>

<style>
  .hd { display: flex; flex-direction: column; gap: 14px; height: 100%; font-size: 11px; }
  .hd-top { display: grid; grid-template-columns: 1fr auto 1.05fr; align-items: center; gap: 10px; flex: 1; }
  .hd-sheet { border: 1px solid var(--border); border-radius: 10px; overflow: hidden; background: #0e1410; }
  .hd-sheet-head, .hd-row { display: grid; grid-template-columns: 1.2fr 1fr; }
  .hd-sheet-head { background: #16251b; color: #7fbf91; font-size: 9px; }
  .hd-sheet-head span, .hd-row span { padding: 5px 8px; border-right: 1px solid rgba(255, 255, 255, 0.06); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .hd-row { border-top: 1px solid rgba(255, 255, 255, 0.06); color: var(--text-muted); font-size: 10.5px; opacity: 0.4; transition: background 0.3s, opacity 0.3s; }
  .hd-row.is-flag { opacity: 1; background: rgba(var(--warning-rgb), 0.12); color: var(--warning); }
  .hd-arrow { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; border: 1px solid rgba(var(--accent-rgb), 0.5); color: var(--accent-text); background: var(--accent-soft); }
  .hd-table { position: relative; display: flex; flex-direction: column; border: 1px solid rgba(var(--accent-rgb), 0.5); border-radius: 10px; background: var(--surface-1); overflow: hidden; }
  .hd-table-head { display: flex; align-items: center; gap: 6px; padding: 7px 9px; border-bottom: 1px solid var(--border); background: var(--accent-soft); color: var(--accent-text); }
  .hd-trow { display: grid; grid-template-columns: 20px 1fr auto; gap: 8px; padding: 7px 9px; border-top: 1px solid var(--border); }
  .hd-trow:nth-child(2) { border-top: 0; }
  .hd-trow .mono { color: var(--text-subtle); font-size: 9.5px; }
  .hd-trow span:last-child { color: var(--text-muted); }
  .hd-badge { display: inline-flex; align-items: center; gap: 5px; margin: 8px 9px 9px; width: fit-content; padding: 3px 8px; border-radius: 99px; background: rgba(var(--signal-rgb), 0.12); color: var(--signal); font-size: 9px; }

  .hd-query { padding: 10px 12px; border: 1px solid var(--border); border-radius: 11px; background: var(--bg); }
  .hd-q { display: flex; gap: 8px; font-size: 11px; color: var(--text); margin-bottom: 10px; }
  .hd-prompt { color: var(--accent-text); }
  .hd-bars { display: flex; flex-direction: column; gap: 6px; }
  .hd-bar { display: grid; grid-template-columns: 52px 1fr; align-items: center; gap: 8px; font-size: 10px; color: var(--text-muted); }
  .hd-bar i { height: 8px; border-radius: 4px; background: var(--surface-3); overflow: hidden; }
  .hd-bar em { display: block; width: var(--v); height: 100%; border-radius: 4px; background: linear-gradient(90deg, var(--accent), var(--accent-text)); transform-origin: left; }

  @media (max-width: 560px) {
    .hd-top { grid-template-columns: 1fr; }
    .hd-arrow { display: none; }
    .hd-sheet .hd-row:nth-child(n + 5) { display: none; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { loopWhenVisible, typeText } from '../../../scripts/loop';

  document.querySelectorAll<HTMLElement>('[data-hd]').forEach((root) => {
    const dirty = Array.from(root.querySelectorAll<HTMLElement>('[data-hd-dirty]'));
    const dups = dirty.filter((r) => r.classList.contains('is-dup'));
    const clean = root.querySelectorAll('[data-hd-clean]');
    const badge = root.querySelector('[data-hd-badge]');
    const arrow = root.querySelector('[data-hd-arrow]');
    const q = root.querySelector<HTMLElement>('[data-hd-q]')!;
    const bars = root.querySelectorAll('[data-hd-bar]');
    const text = q.textContent ?? '';

    loopWhenVisible(root, (tl) => {
      tl.to({}, { duration: 1.4 })
        .to([clean, badge], { autoAlpha: 0, x: 10, duration: 0.3 })
        .to(bars, { scaleX: 0, duration: 0.3 }, '<')
        .call(() => (q.textContent = ''))
        .to(dirty, { opacity: 1, duration: 0.3 }, '<')
        // Se detectan los duplicados
        .call(() => dups.forEach((r) => r.classList.add('is-flag')), [], '+=0.2')
        .to(arrow, { scale: 1.15, duration: 0.25, yoyo: true, repeat: 3 }, '+=0.3')
        // Se unen y aparecen limpios
        .call(() => dups.forEach((r) => r.classList.remove('is-flag')))
        .to(dirty, { opacity: 0.4, duration: 0.3, stagger: 0.05 })
        .to(clean, { autoAlpha: 1, x: 0, duration: 0.4, stagger: 0.2, ease: 'back.out(1.6)' }, '<0.1')
        .to(badge, { autoAlpha: 1, x: 0, duration: 0.4, ease: 'back.out(2)' })
        // Y responde preguntas
        .add(typeText(q, text, 0.9), '+=0.2')
        .to(bars, { scaleX: 1, duration: 0.7, stagger: 0.12, ease: 'power3.out' })
        .to({}, { duration: 2 });
    });
  });
</script>
