---
// IA aplicada: documentos y mensajes entran, la IA los lee y decide; lo dudoso pasa a una persona.
import VisualFrame from '../VisualFrame.astro';
import Icon, { type IconName } from '../../ui/Icon.astro';

const entradas: { icon: IconName; t: string; s: string }[] = [
  { icon: 'file', t: 'factura_0342.pdf', s: 'Correo de proveedor' },
  { icon: 'layers', t: 'comprobante.jpg', s: 'WhatsApp de cliente' },
  { icon: 'whatsapp', t: '¿Tienen domicilio?', s: 'Mensaje entrante' },
];
const salidas = [
  { tono: 'ok', t: 'Datos extraídos', s: '$ 4.280.000 · IVA ✓', c: '99 %' },
  { tono: 'warn', t: 'Revisión humana', s: 'La fecha no coincide', c: '61 %' },
  { tono: 'ok', t: 'Respondido', s: 'Sí, de 11 a. m. a 9 p. m.', c: '97 %' },
];
---

<VisualFrame label="asistente-ia · bandeja" status="supervisado">
  <div class="hi" data-hi>
    <div class="hi-col">
      <p class="hi-h mono">Entra</p>
      {entradas.map((e) => (
        <div class="hi-doc" data-hi-doc>
          <span class="hi-ico"><Icon name={e.icon} size={14} /></span>
          <div><b>{e.t}</b><span>{e.s}</span></div>
        </div>
      ))}
    </div>

    <div class="hi-core" data-hi-core>
      <span class="hi-ring"></span>
      <span class="hi-ring hi-ring--2"></span>
      <Icon name="sparkles" size={26} />
      <b>IA</b>
      <span class="hi-status mono" data-hi-status>lista</span>
    </div>

    <div class="hi-col">
      <p class="hi-h mono">Sale</p>
      {salidas.map((o) => (
        <div class:list={['hi-out', `hi-out--${o.tono}`]} data-hi-out>
          <div><b>{o.t}</b><span>{o.s}</span></div>
          <em class="mono">{o.c}</em>
        </div>
      ))}
    </div>

    <span class="hi-packet" data-hi-packet></span>
  </div>
</VisualFrame>

<style>
  .hi {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 26% 1fr;
    align-items: center;
    gap: 14px;
    height: 100%;
    font-size: 11px;
  }
  .hi-col { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .hi-h { font-size: 9.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-subtle); }
  .hi-doc, .hi-out {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 9px 10px;
    border: 1px solid var(--border);
    border-radius: 11px;
    background: var(--surface-1);
    min-width: 0;
  }
  .hi-doc div, .hi-out div { display: flex; flex-direction: column; min-width: 0; }
  .hi-doc b, .hi-out b { font-size: 11px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .hi-doc span, .hi-out span { font-size: 9.5px; color: var(--text-subtle); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .hi-doc { opacity: 0.5; }
  .hi-doc.is-reading { opacity: 1; border-color: var(--accent); box-shadow: 0 0 0 3px rgba(var(--accent-rgb), 0.15); }
  .hi-ico { display: grid; place-items: center; flex: none; width: 28px; height: 28px; border-radius: 8px; background: var(--surface-3); color: var(--text-muted); }
  .hi-out { justify-content: space-between; }
  .hi-out em { font-style: normal; font-size: 10px; flex: none; }
  .hi-out--ok { border-color: rgba(var(--signal-rgb), 0.4); }
  .hi-out--ok b, .hi-out--ok em { color: var(--signal); }
  .hi-out--warn { border-color: rgba(var(--warning-rgb), 0.45); background: rgba(var(--warning-rgb), 0.06); }
  .hi-out--warn b, .hi-out--warn em { color: var(--warning); }

  .hi-core {
    position: relative;
    display: grid;
    place-items: center;
    gap: 2px;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid rgba(var(--accent-rgb), 0.6);
    background: radial-gradient(circle, rgba(var(--accent-rgb), 0.28), var(--surface-2) 70%);
    color: var(--accent-text);
    text-align: center;
    padding: 18%;
  }
  .hi-core b { font-size: 15px; color: var(--text); line-height: 1; }
  .hi-status { font-size: 9px; color: var(--text-muted); }
  .hi-ring { position: absolute; inset: -10%; border-radius: 50%; border: 1px dashed rgba(var(--accent-rgb), 0.45); animation: hi-spin 9s linear infinite; }
  .hi-ring--2 { inset: -22%; border-style: solid; border-color: rgba(var(--accent-rgb), 0.15); animation-duration: 14s; animation-direction: reverse; }
  @keyframes hi-spin { to { rotate: 360deg; } }

  .hi-packet {
    position: absolute;
    left: 0;
    top: 0;
    width: 10px;
    height: 10px;
    margin: -5px 0 0 -5px;
    border-radius: 50%;
    background: var(--accent-text);
    box-shadow: 0 0 14px var(--accent);
    opacity: 0;
  }
  @media (max-width: 560px) {
    .hi { grid-template-columns: 1fr 22% 1fr; gap: 8px; }
    .hi-ico { display: none; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { loopWhenVisible, centerIn } from '../../../scripts/loop';

  document.querySelectorAll<HTMLElement>('[data-hi]').forEach((root) => {
    const docs = Array.from(root.querySelectorAll<HTMLElement>('[data-hi-doc]'));
    const outs = Array.from(root.querySelectorAll<HTMLElement>('[data-hi-out]'));
    const core = root.querySelector<HTMLElement>('[data-hi-core]')!;
    const status = root.querySelector<HTMLElement>('[data-hi-status]')!;
    const packet = root.querySelector<HTMLElement>('[data-hi-packet]')!;
    const pos = (el: Element) => ({ x: () => centerIn(root, el).x, y: () => centerIn(root, el).y });

    loopWhenVisible(root, (tl) => {
      tl.to({}, { duration: 1.4 }).to(outs, { autoAlpha: 0, x: 12, duration: 0.3, stagger: 0.05 });
      docs.forEach((doc, i) => {
        tl.call(() => {
          doc.classList.add('is-reading');
          status.textContent = 'leyendo…';
        })
          .set(packet, { ...pos(doc), autoAlpha: 1, scale: 1 })
          .to(packet, { ...pos(core), duration: 0.55, ease: 'power2.in' })
          .to(core, { scale: 1.08, duration: 0.15, yoyo: true, repeat: 1 })
          .call(() => {
            status.textContent = i === 1 ? 'dudosa' : 'decidido';
          })
          .to(packet, { ...pos(outs[i]), duration: 0.55, ease: 'power2.out' })
          .set(packet, { autoAlpha: 0 })
          .to(outs[i], { autoAlpha: 1, x: 0, duration: 0.4, ease: 'back.out(1.7)' }, '<')
          .call(() => doc.classList.remove('is-reading'))
          .to({}, { duration: 0.2 });
      });
      tl.call(() => (status.textContent = 'lista')).to({}, { duration: 2 });
    });
  });
</script>
