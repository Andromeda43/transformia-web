---
// src/components/ui/Logo.astro — marca: "T" cuyo trazo termina en un nodo (el dato que fluye).
interface Props {
  size?: number;
  showWordmark?: boolean;
  class?: string;
}
const { size = 30, showWordmark = true, class: className = '' } = Astro.props;
---

<span class:list={['logo', className]}>
  <svg width={size} height={size} viewBox="0 0 64 64" fill="none" aria-hidden="true">
    <rect width="64" height="64" rx="16" fill="var(--surface-2)" />
    <rect x="0.5" y="0.5" width="63" height="63" rx="15.5" stroke="var(--border-strong)" />
    <path d="M17 20h30" stroke="var(--text)" stroke-width="5" stroke-linecap="round" />
    <path d="M32 20v24" stroke="var(--text)" stroke-width="5" stroke-linecap="round" />
    <circle class="logo-node" cx="32" cy="46" r="5" fill="var(--accent)" />
  </svg>
  {showWordmark && <span class="logo-word">Transformia</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .logo-word {
    font-weight: 600;
    font-size: 1.15rem;
    letter-spacing: -0.03em;
    color: var(--text);
  }
  .logo-node {
    transform-origin: 32px 46px;
    transition: transform var(--dur) var(--ease-out);
  }
  :global(a:hover) > .logo .logo-node {
    transform: scale(1.25);
  }
</style>
