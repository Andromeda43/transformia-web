---
// src/components/ui/SectionHeader.astro — etiqueta numerada en mono + título revelado por líneas.
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
  as?: 'h1' | 'h2';
  size?: 'display' | 'h1' | 'h2';
  id?: string;
}

const { eyebrow, title, lead, align = 'left', as: Tag = 'h2', size = 'h2', id } = Astro.props;
---

<header class:list={['section-header', `section-header--${align}`]} id={id}>
  {eyebrow && <p class="eyebrow" data-reveal>{eyebrow}</p>}
  <Tag class:list={['section-header-title', size]} data-split>{title}</Tag>
  {lead && <p class="lead" data-reveal>{lead}</p>}
  <slot />
</header>

<style>
  .section-header {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    margin-bottom: clamp(2.5rem, 2rem + 2vw, 4rem);
    max-width: 780px;
  }
  .section-header--center {
    align-items: center;
    text-align: center;
    margin-inline: auto;
  }
  .section-header--center .lead {
    margin-inline: auto;
  }
  .section-header-title {
    color: var(--text);
  }
</style>
