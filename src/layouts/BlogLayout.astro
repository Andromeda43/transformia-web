---
// src/layouts/BlogLayout.astro — artículo del blog con barra de progreso de lectura.
import { render, getCollection, type CollectionEntry } from 'astro:content';
import MainLayout from './MainLayout.astro';
import Icon from '../components/ui/Icon.astro';
import CallToAction from '../components/CallToAction.astro';
import { breadcrumbSchema } from '../lib/seo/breadcrumb';
import { articleSchema } from '../lib/seo/article';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = entry.data;
const { Content } = await render(entry);

const fecha = pubDate.toLocaleDateString('es-CO', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const palabras = (entry.body ?? '').split(/\s+/).length;
const minutos = Math.max(1, Math.round(palabras / 220));

const otros = (await getCollection('blog', ({ data, id }) => !data.draft && id !== entry.id))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const url = new URL(`/blog/${entry.id}`, Astro.site).toString();
const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Blog', path: '/blog' },
  { name: title, path: `/blog/${entry.id}` },
];
---

<MainLayout
  title={`${title} | Blog Transformia`}
  description={description}
  type="article"
  jsonLd={[
    breadcrumbSchema(crumbs, Astro.site!),
    articleSchema({ title, description, pubDate, updatedDate, url, image: new URL('/og-default.jpg', Astro.site).toString() }),
  ]}
>
  <div class="progress" aria-hidden="true"><span data-progress></span></div>

  <article class="post">
    <header class="post-head container container--narrow">
      <a href="/blog" class="back mono" data-reveal><Icon name="arrow" size={14} class="back-icon" /> Blog</a>
      <h1 class="h1" data-split>{title}</h1>
      <p class="lead" data-reveal>{description}</p>
      <div class="post-meta mono" data-reveal>
        <time datetime={pubDate.toISOString()}>{fecha}</time>
        <span>·</span>
        <span>{minutos} min de lectura</span>
        {tags.length > 0 && <span>·</span>}
        {tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    </header>

    <div class="container container--narrow">
      <div class="prose post-body" data-post-body>
        <Content />
      </div>
    </div>
  </article>

  {otros.length > 0 && (
    <section class="section section--tight">
      <div class="container container--narrow">
        <p class="eyebrow eyebrow--plain">Sigue leyendo</p>
        <ul class="more" role="list">
          {otros.map((o) => (
            <li>
              <a href={`/blog/${o.id}`}>
                <span>{o.data.title}</span>
                <Icon name="arrow" size={18} />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <CallToAction />
</MainLayout>

<style>
  .progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 101;
    height: 2px;
  }
  .progress span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--accent), var(--signal));
    transform: scaleX(0);
    transform-origin: left;
  }
  .post {
    padding-top: calc(var(--nav-height) + clamp(3rem, 2rem + 4vw, 5.5rem));
  }
  .post-head {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: clamp(2.5rem, 2rem + 2vw, 4rem);
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    width: fit-content;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .back :global(.back-icon) {
    transform: rotate(180deg);
  }
  .back:hover {
    color: var(--accent-text);
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-size: 0.75rem;
    color: var(--text-subtle);
  }
  .tag {
    color: var(--accent-text);
  }
  .post-body {
    padding-bottom: 2rem;
  }
  .post-body :global(h2:first-child) {
    margin-top: 0;
  }
  .more {
    display: flex;
    flex-direction: column;
    margin-top: 1rem;
  }
  .more a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--border);
    font-size: 1.15rem;
    font-weight: 500;
    transition: color var(--dur-fast);
  }
  .more li:last-child a {
    border-bottom: 1px solid var(--border);
  }
  .more a:hover {
    color: var(--accent-text);
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  const body = document.querySelector<HTMLElement>('[data-post-body]');
  if (bar && body) {
    let ticking = false;
    const update = () => {
      const r = body.getBoundingClientRect();
      const total = r.height - window.innerHeight * 0.6;
      const p = Math.min(1, Math.max(0, -r.top / Math.max(total, 1)));
      bar.style.transform = `scaleX(${p})`;
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true }
    );
    update();
  }
</script>
