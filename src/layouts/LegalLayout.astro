---
// src/layouts/LegalLayout.astro — páginas legales en formato de lectura.
import MainLayout from './MainLayout.astro';
import { breadcrumbSchema } from '../lib/seo/breadcrumb';

interface Props {
  title: string;
  description: string;
  path: string;
  updated: string;
}
const { title, description, path, updated } = Astro.props;
const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: title, path },
];
---

<MainLayout title={`${title} | Transformia`} description={description} jsonLd={[breadcrumbSchema(crumbs, Astro.site!)]}>
  <article class="legal">
    <header class="container container--narrow legal-head">
      <p class="eyebrow">Legal</p>
      <h1 class="h1">{title}</h1>
      <p class="mono legal-updated">Última actualización: {updated}</p>
    </header>
    <div class="container container--narrow">
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</MainLayout>

<style>
  .legal {
    padding: calc(var(--nav-height) + clamp(3rem, 2rem + 4vw, 5rem)) 0 var(--section-y);
  }
  .legal-head {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }
  .legal-updated {
    font-size: 0.78rem;
    color: var(--text-subtle);
  }
</style>
