---
// src/pages/blog/index.astro
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import BlogPostCard from '../../components/BlogPostCard.astro';
import CallToAction from '../../components/CallToAction.astro';
import { breadcrumbSchema } from '../../lib/seo/breadcrumb';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Blog', path: '/blog' },
];
---

<MainLayout
  title="Blog | Transformia"
  description="Artículos de Transformia sobre software a la medida, inteligencia artificial aplicada, automatización y arquitectura de sistemas."
  jsonLd={[breadcrumbSchema(crumbs, Astro.site!)]}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Blog"
    title="Lo que aprendemos construyendo."
    lead="Notas prácticas de proyectos reales: cuándo construir a la medida, cómo aplicar IA sin humo y qué decisiones técnicas salen caras si se toman tarde."
  />

  <section class="section section--tight">
    <div class="container">
      {posts.length > 0 ? (
        <div>{posts.map((entry) => <BlogPostCard entry={entry} headingLevel="h2" />)}</div>
      ) : (
        <p class="muted">Todavía no hay artículos publicados. Vuelve pronto.</p>
      )}
    </div>
  </section>

  <CallToAction />
</MainLayout>
