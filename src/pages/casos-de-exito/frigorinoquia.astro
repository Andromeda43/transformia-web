---
// src/pages/casos-de-exito/frigorinoquia.astro
import { Image } from 'astro:assets';
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import FrigorinoquiaPipeline from '../../components/casos-de-exito/FrigorinoquiaPipeline.astro';
import ScreenshotGallery from '../../components/casos/ScreenshotGallery.astro';

import screenshotApertura from '../../assets/casos-de-exito/frigorinoquia/screenshot-apertura.png';
import screenshotPesaje from '../../assets/casos-de-exito/frigorinoquia/screenshot-pesaje.png';
import screenshotRecepcionDashboard from '../../assets/casos-de-exito/frigorinoquia/screenshot-recepcion-dashboard.png';
import screenshotDespachoDesposte from '../../assets/casos-de-exito/frigorinoquia/screenshot-despacho-desposte.png';
import screenshotReporteBeneficio from '../../assets/casos-de-exito/frigorinoquia/screenshot-reporte-beneficio-animales.png';
import fotoImpresora from '../../assets/casos-de-exito/frigorinoquia/foto-etiqueta-zpl-impresora-test.jpg';
import fotoProductoTerminado from '../../assets/casos-de-exito/frigorinoquia/foto-etiqueta-zpl-producto-terminado.jpg';
import screenshotGuiaDespacho from '../../assets/casos-de-exito/frigorinoquia/screenshot-guia-despacho.png';

const shots = [
  { src: screenshotReporteBeneficio, alt: 'Reporte de beneficio de animales con indicadores de rendimiento', label: 'Reportes' },
  { src: screenshotApertura, alt: 'Pantalla de apertura de lote de desposte', label: 'Apertura de lote' },
  { src: screenshotPesaje, alt: 'Pantalla de pesaje en tiempo real conectada a báscula', label: 'Pesaje en tiempo real' },
  { src: screenshotRecepcionDashboard, alt: 'Tablero de recepción de animales en planta', label: 'Recepción' },
  { src: screenshotDespachoDesposte, alt: 'Pantalla de despacho de cortes de desposte', label: 'Despacho' },
];
---

<CaseStudyLayout
  slug="frigorinoquia"
  cliente="Frigorinoquia"
  industria="Planta de beneficio animal y desposte — Tauramena, Casanare"
  description="Suite de 6 aplicaciones construida por Transformia para Frigorinoquia: trazabilidad de beneficio y desposte de punta a punta, con captura de datos en tiempo real y sin doble digitación."
  dolor="Frigorinoquia es una planta de beneficio animal y sala de desposte mixto. Todo el proceso, desde el ingreso del animal hasta la salida del producto, se documentaba en papel y Excel: apertura de lote manual, pesaje sin sistema, sin visibilidad del inventario en cámara fría, guías de despacho escritas a mano con errores frecuentes, reportes gerenciales que llegaban días tarde, cobranza calculada a mano y una trazabilidad animal incompleta."
  solucion="Una suite de seis aplicaciones web, cada una responsable de una estación de la planta, conectadas a la misma base de datos. El peso se lee directamente de la báscula, las etiquetas se generan e imprimen al momento del registro, el inventario se actualiza solo con cada pesaje mediante funciones transaccionales y la liquidación de maquila sale de esos mismos datos operativos."
  capacidades={[
    'Apertura de lote, fichas técnicas de cortes y consolidados diarios',
    'Pesaje en tiempo real con impresión automática de etiqueta en cada registro',
    'Despacho de canales y de cortes empacados, con guías y certificados generados por el sistema',
    'Tablero de indicadores y reportes exportables a PDF y Excel',
    'Liquidación automática de maquila, cuentas por cobrar y pagos',
    'Trazabilidad por lote: beneficio → desposte → pesaje → despacho → cliente',
  ]}
  stack={['Python', 'FastAPI', 'Supabase', 'PostgreSQL', 'PySerial', 'ZPL / Zebra', 'PyInstaller']}
  resultado="Frigorinoquia pasa de un proceso en papel y Excel a una suite conectada donde cada animal, lote, corte y despacho queda trazado de punta a punta: el peso capturado en la fuente, las etiquetas impresas automáticamente, el inventario descontado en tiempo real y la cobranza generada con los mismos datos, sin doble digitación."
  status="ejecutado"
>
  <FrigorinoquiaPipeline slot="solucion-extra" />

  <div slot="evidencia" class="evidence">
    <p class="evidence-intro" data-reveal>Una sola fuente de verdad. Así se ve el sistema en las estaciones de la planta (haz clic para ampliar).</p>
    <ScreenshotGallery shots={shots} />

    <div class="physical">
      <figure class="photo photo--tall" data-reveal>
        <Image src={fotoImpresora} alt="Impresora imprimiendo etiquetas con datos de la planta en tiempo real" widths={[500, 900]} sizes="(max-width: 700px) 100vw, 420px" loading="lazy" />
        <figcaption>Etiquetas impresas en el momento del pesaje</figcaption>
      </figure>
      <figure class="photo" data-reveal>
        <Image src={fotoProductoTerminado} alt="Etiqueta impresa sobre producto empacado" widths={[400, 700]} sizes="(max-width: 700px) 100vw, 420px" loading="lazy" />
        <figcaption>Etiqueta sobre producto terminado, lista para despacho</figcaption>
      </figure>
      <figure class="photo" data-reveal>
        <Image src={screenshotGuiaDespacho} alt="Guía de despacho generada automáticamente, con datos del cliente protegidos" widths={[400, 700]} sizes="(max-width: 700px) 100vw, 420px" loading="lazy" />
        <figcaption>Guía de despacho generada por el sistema</figcaption>
      </figure>
      <div class="kpi-card" data-reveal>
        <span class="kpi-value mono" data-count="56.57" data-decimals="2" data-suffix="%">56,57%</span>
        <span class="kpi-label">Rendimiento promedio de beneficio, medido en tiempo real por el sistema</span>
      </div>
    </div>
  </div>
</CaseStudyLayout>

<style>
  .evidence {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .evidence-intro {
    color: var(--text-muted);
  }
  .physical {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .photo {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-1);
    overflow: hidden;
  }
  .photo :global(img) {
    width: 100%;
    height: 240px;
    object-fit: cover;
  }
  .photo--tall :global(img) {
    height: 100%;
    min-height: 240px;
  }
  .photo--tall {
    grid-row: span 2;
    display: flex;
    flex-direction: column;
  }
  .photo--tall :global(img) {
    flex: 1;
  }
  .photo figcaption {
    padding: 0.75rem 1rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .kpi-card {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem 1.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-1);
  }
  .kpi-value {
    font-size: clamp(2.2rem, 1.6rem + 2vw, 3.2rem);
    font-weight: 700;
    color: var(--signal);
    letter-spacing: -0.03em;
  }
  .kpi-label {
    color: var(--text-muted);
    max-width: 36ch;
  }
  @media (max-width: 700px) {
    .physical {
      grid-template-columns: 1fr;
    }
    .photo--tall {
      grid-row: auto;
    }
    .kpi-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>
