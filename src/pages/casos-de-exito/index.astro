---
// src/pages/casos-de-exito/index.astro
import MainLayout from '../../layouts/MainLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import CaseCard from '../../components/casos/CaseCard.astro';
import CallToAction from '../../components/CallToAction.astro';
import { casosDeExito } from '../../data/casosDeExito';
import { breadcrumbSchema } from '../../lib/seo/breadcrumb';

const ejecutados = casosDeExito.filter((c) => c.status === 'ejecutado');
const [principal, ...resto] = ejecutados;
const propuestas = casosDeExito.filter((c) => c.status === 'propuesta');
const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Casos', path: '/casos-de-exito' },
];
---

<MainLayout
  title="Casos de éxito | Transformia"
  description="Proyectos reales de Transformia: trazabilidad industrial, apps móviles, plataformas y sitios web construidos a la medida para empresas en Colombia y el exterior."
  jsonLd={[breadcrumbSchema(crumbs, Astro.site!)]}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Casos de éxito"
    title="Proyectos reales, problemas reales."
    lead="Cada caso cuenta lo mismo que contamos en una propuesta: de dónde partimos, qué construimos y qué cambió en la operación."
  />

  <section class="section section--tight">
    <div class="container list">
      {principal && <CaseCard caso={principal} size="large" headingLevel="h2" />}
      <div class="grid">
        {resto.map((c) => <CaseCard caso={c} headingLevel="h2" />)}
      </div>
    </div>
  </section>

  {propuestas.length > 0 && (
    <section class="section section--tight">
      <div class="container">
        <SectionHeader
          eyebrow="Propuestas técnicas"
          title="Diseñado, aún no ejecutado."
          lead="Proyectos que formulamos y no fueron financiados. Los mostramos por transparencia, nunca como resultados entregados."
        />
        <div class="grid">
          {propuestas.map((c) => <CaseCard caso={c} headingLevel="h3" />)}
        </div>
      </div>
    </section>
  )}

  <CallToAction title="El próximo caso puede ser el tuyo." />
</MainLayout>

<style>
  .list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 1rem;
  }
</style>
