---
import MainLayout from '../layouts/MainLayout.astro';
import ContactoForm from '../components/ContactoForm.astro';
import { breadcrumbSchema } from '../lib/seo/breadcrumb';

const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Contacto', path: '/contacto' },
];
---

<MainLayout
  title="Contacto | Transformia"
  description="Cuéntanos tu proyecto de software. Agenda un diagnóstico de 30 minutos sin costo por WhatsApp, correo o teléfono."
  jsonLd={[breadcrumbSchema(crumbs, Astro.site!)]}
>
  <ContactoForm />
</MainLayout>
