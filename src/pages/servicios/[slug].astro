---
// src/pages/servicios/[slug].astro — plantilla de servicio.
// Datos base en src/data/servicios.ts; contenido explicativo en src/data/serviciosContenido.ts;
// cada servicio tiene su propia animación de hero en src/components/servicios/visuals/.
import MainLayout from '../../layouts/MainLayout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import CaseCard from '../../components/casos/CaseCard.astro';
import ProductCard from '../../components/productos/ProductCard.astro';
import CallToAction from '../../components/CallToAction.astro';
import ServiceHero from '../../components/servicios/ServiceHero.astro';
import ServiceWhat from '../../components/servicios/ServiceWhat.astro';
import ServiceBenefits from '../../components/servicios/ServiceBenefits.astro';
import ScenarioExplorer from '../../components/servicios/ScenarioExplorer.astro';
import ServiceSteps from '../../components/servicios/ServiceSteps.astro';
import ServiceFaq from '../../components/servicios/ServiceFaq.astro';
import HeroWeb from '../../components/servicios/visuals/HeroWeb.astro';
import HeroSoftware from '../../components/servicios/visuals/HeroSoftware.astro';
import HeroIA from '../../components/servicios/visuals/HeroIA.astro';
import HeroAuto from '../../components/servicios/visuals/HeroAuto.astro';
import HeroDatos from '../../components/servicios/visuals/HeroDatos.astro';
import HeroIntegraciones from '../../components/servicios/visuals/HeroIntegraciones.astro';
import HeroArquitectura from '../../components/servicios/visuals/HeroArquitectura.astro';
import HeroAsesoria from '../../components/servicios/visuals/HeroAsesoria.astro';
import { servicios, grupos, type Servicio } from '../../data/servicios';
import { contenidoServicios } from '../../data/serviciosContenido';
import { casosDeExito } from '../../data/casosDeExito';
import { productos } from '../../data/productos';
import { whatsappLink } from '../../data/site';
import { breadcrumbSchema } from '../../lib/seo/breadcrumb';
import { serviceSchema } from '../../lib/seo/service';
import { faqSchema } from '../../lib/seo/faq';

export function getStaticPaths() {
  return servicios.map((servicio) => ({ params: { slug: servicio.slug }, props: { servicio } }));
}

const visuales = {
  'sitios-web': HeroWeb,
  desarrollo: HeroSoftware,
  ia: HeroIA,
  transformacion: HeroAuto,
  database: HeroDatos,
  iot: HeroIntegraciones,
  arquitectura: HeroArquitectura,
  asesoria: HeroAsesoria,
} as const;

interface Props {
  servicio: Servicio;
}
const { servicio: s } = Astro.props;
const c = contenidoServicios[s.slug];
const Visual = visuales[s.slug as keyof typeof visuales];
const grupo = grupos.find((g) => g.id === s.grupo)!;
const relacionados = s.casos.map((slug) => casosDeExito.find((caso) => caso.slug === slug)).filter((caso) => caso !== undefined);
const productosRel = productos.filter((p) => s.productos?.includes(p.id));
const otros = servicios.filter((o) => o.slug !== s.slug);
const url = new URL(`/servicios/${s.slug}`, Astro.site).toString();
const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Servicios', path: '/servicios' },
  { name: s.nombre, path: `/servicios/${s.slug}` },
];
---

<MainLayout
  title={s.seoTitle}
  description={s.seoDescription}
  jsonLd={[
    breadcrumbSchema(crumbs, Astro.site!),
    serviceSchema({ name: s.nombre, description: s.seoDescription, url }),
    ...(c ? [faqSchema(c.faq)] : []),
  ]}
>
  <ServiceHero crumbs={crumbs} eyebrow={grupo.nombre} title={s.nombre} lead={s.resumen}>
    <div slot="actions" class="hero-actions" data-reveal>
      <Button href="/contacto" icon="arrow" magnetic>Agenda un diagnóstico</Button>
      <Button href={whatsappLink(`Hola, me interesa el servicio de ${s.nombreCorto.toLowerCase()}.`)} variant="secondary" iconStart="whatsapp" external>
        Escríbenos por WhatsApp
      </Button>
    </div>
    <Fragment slot="visual">{Visual && <Visual />}</Fragment>
  </ServiceHero>

  {c && (
    <>
      <ServiceWhat pregunta={c.queEs.pregunta} titulo={c.queEs.titulo} texto={c.queEs.texto} analogia={c.queEs.analogia} />
      <ServiceBenefits lead={s.problema} beneficios={c.beneficios} />
      <ScenarioExplorer id={`esc-${s.slug}`} escenarios={c.escenarios} />
      <ServiceSteps lead={s.enfoque} pasos={c.pasos} />
    </>
  )}

  <section class="section section--surface">
    <div class="container includes">
      <SectionHeader eyebrow="Alcance" title="Qué incluye" lead="Cada propuesta detalla también lo que no incluye, para que sepas exactamente qué recibes." />
      <ol class="include-list" role="list">
        {s.incluye.map((item, i) => (
          <li data-reveal>
            <span class="mono">{String(i + 1).padStart(2, '0')}</span>
            <p>{item}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container meta-grid">
      <div data-reveal>
        <p class="eyebrow eyebrow--plain">Lo que construimos</p>
        <ul class="chip-list" role="list">
          {s.ejemplos.map((e) => <li><Icon name="check" size={14} strokeWidth={2.2} />{e}</li>)}
        </ul>
      </div>
      <div data-reveal>
        <p class="eyebrow eyebrow--plain">Tecnologías habituales</p>
        <ul class="chip-list chip-list--mono" role="list">
          {s.tecnologias.map((t) => <li>{t}</li>)}
        </ul>
      </div>
    </div>
  </section>

  {c && <ServiceFaq faq={c.faq} servicio={s.nombreCorto} />}

  {(relacionados.length > 0 || productosRel.length > 0) && (
    <section class="section section--tight">
      <div class="container">
        <SectionHeader eyebrow="En la práctica" title={relacionados.length > 0 ? 'Casos relacionados' : 'Lo aplicamos en nuestros productos'} />
        <div class="related">
          {relacionados.map((caso) => <CaseCard caso={caso} />)}
          {productosRel.map((p) => <ProductCard producto={p} />)}
        </div>
      </div>
    </section>
  )}

  <section class="section section--tight">
    <div class="container">
      <p class="eyebrow eyebrow--plain others-title">Otros servicios</p>
      <ul class="others" role="list">
        {otros.map((o) => (
          <li>
            <a href={`/servicios/${o.slug}`}>
              <Icon name={o.icon} size={18} />
              <span>{o.nombreCorto}</span>
              <Icon name="arrow" size={16} class="others-arrow" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CallToAction />
</MainLayout>

<style>
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .includes {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 3rem;
    align-items: start;
  }
  .include-list {
    display: flex;
    flex-direction: column;
  }
  .include-list li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    padding: 1.15rem 0;
    border-top: 1px solid var(--border);
    font-size: 1.05rem;
  }
  .include-list li:last-child {
    border-bottom: 1px solid var(--border);
  }
  .include-list .mono {
    color: var(--accent-text);
    font-size: 0.8rem;
    padding-top: 0.2rem;
  }
  .meta-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem;
  }
  .chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .chip-list li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--surface-1);
    font-size: 0.9rem;
  }
  .chip-list li :global(svg) {
    color: var(--signal);
  }
  .chip-list--mono li {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .related {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 1rem;
  }
  .others-title {
    margin-bottom: 1rem;
  }
  .others {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .others a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--text-muted);
    transition: border-color var(--dur-fast), color var(--dur-fast), background var(--dur-fast);
  }
  .others a:hover {
    border-color: var(--accent);
    color: var(--text);
    background: var(--accent-soft);
  }
  .others :global(.others-arrow) {
    margin-left: auto;
  }
  @media (max-width: 900px) {
    .includes,
    .meta-grid {
      grid-template-columns: 1fr;
    }
    .others {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .others {
      grid-template-columns: 1fr;
    }
    .hero-actions :global(.btn) {
      width: 100%;
    }
  }
</style>
