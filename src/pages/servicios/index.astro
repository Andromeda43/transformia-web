---
// src/pages/servicios/index.astro
import MainLayout from '../../layouts/MainLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Icon from '../../components/ui/Icon.astro';
import ProcessStack from '../../components/home/ProcessStack.astro';
import CallToAction from '../../components/CallToAction.astro';
import { grupos, serviciosPorGrupo } from '../../data/servicios';
import { breadcrumbSchema } from '../../lib/seo/breadcrumb';

const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Servicios', path: '/servicios' },
];
---

<MainLayout
  title="Servicios de desarrollo de software e IA | Transformia"
  description="Software a la medida, IA aplicada, automatización, integraciones, bases de datos, arquitectura y asesoría. Siete servicios en cuatro frentes, con un mismo método por fases."
  jsonLd={[breadcrumbSchema(crumbs, Astro.site!)]}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Servicios"
    title="Todo lo que tu operación necesita, en un solo equipo."
    lead="Siete servicios organizados en cuatro frentes. Puedes contratar uno o combinarlos: el método es el mismo, por fases y con precio fijo."
  />

  <section class="section section--tight">
    <div class="container groups">
      {grupos.map((g, gi) => (
        <div class="group">
          <div class="group-head" data-reveal>
            <span class="group-num mono">{String(gi + 1).padStart(2, '0')}</span>
            <span class="group-icon"><Icon name={g.icon} size={20} /></span>
            <h2 class="h3">{g.nombre}</h2>
            <p class="muted">{g.resumen}</p>
          </div>
          <div class="group-services">
            {serviciosPorGrupo(g.id).map((s) => (
              <a href={`/servicios/${s.slug}`} class="svc spot" data-spotlight data-reveal>
                <div class="svc-top">
                  <span class="svc-icon"><Icon name={s.icon} size={18} /></span>
                  <Icon name="arrow-up-right" size={20} class="svc-arrow" />
                </div>
                <h3 class="svc-title">{s.nombre}</h3>
                <p class="svc-text">{s.resumen}</p>
                <ul class="svc-tags" role="list">
                  {s.ejemplos.slice(0, 3).map((e) => <li>{e}</li>)}
                </ul>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <ProcessStack eyebrow="Cómo trabajamos" />
  <CallToAction />
</MainLayout>

<style>
  .groups {
    display: flex;
    flex-direction: column;
  }
  .group {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.5fr);
    gap: 2.5rem;
    padding-block: 3rem;
    border-top: 1px solid var(--border);
  }
  .group-head {
    position: sticky;
    top: calc(var(--nav-height) + 2rem);
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .group-num {
    font-size: 0.75rem;
    color: var(--accent-text);
  }
  .group-icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    border: 1px solid var(--border-strong);
    background: var(--surface-2);
    color: var(--accent-text);
  }
  .group-services {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .group-services:has(> :only-child) {
    grid-template-columns: 1fr;
  }
  .svc {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.6rem;
  }
  .svc-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .svc-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--accent-soft);
    color: var(--accent-text);
  }
  .svc :global(.svc-arrow) {
    color: var(--text-subtle);
    transition: transform var(--dur) var(--ease-out), color var(--dur);
  }
  .svc:hover :global(.svc-arrow) {
    color: var(--accent-text);
    transform: translate(3px, -3px);
  }
  .svc-title {
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }
  .svc-text {
    color: var(--text-muted);
    font-size: var(--text-small);
  }
  .svc-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }
  .svc-tags li {
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    font-size: 0.75rem;
    color: var(--text-subtle);
  }
  @media (max-width: 900px) {
    .group {
      grid-template-columns: 1fr;
    }
    .group-head {
      position: static;
    }
  }
  @media (max-width: 600px) {
    .group-services {
      grid-template-columns: 1fr;
    }
  }
</style>
